  @@index([walletId])
  @@index([walletType])
}

model JobLifecycleEvent {
  id          String   @id @default(cuid())
  jobId       String
  job         MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId     String?
  actorType   String
  action      String
  fromState   String?
  toState     String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([action])
  @@index([actorId])
}

model JobVerificationPin {
  id                  String    @id @default(cuid())
  jobId               String
  customerId          String
  pinHash             String    // bcrypt hash via hashPassword() (SHA-256+pepper+bcrypt)
  status              String    @default("ACTIVE") // ACTIVE, ROTATED, REVOKED
  version             Int       @default(1)
  failedAttempts      Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  rotatedAt           DateTime?
  revokedAt           DateTime?
  lastSuccessfulUseAt DateTime?

  // Phase 10.5 closure: per-purpose verification timestamps (atomic consumption)
  arrivalVerifiedAt     DateTime?
  workStartVerifiedAt   DateTime?
  completionVerifiedAt  DateTime?

  job      MarketplaceJob @relation(fields: [jobId], references: [id])
  customer User           @relation(fields: [customerId], references: [id])

  @@unique([jobId, version])
  @@index([jobId])
  @@index([customerId])
}

// Phase 10.7 — Company Workforce: formal job assignment tracking
model CompanyJobAssignment {
  id            String   @id @default(cuid())
  companyId     String
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId         String
  job           MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerUserId  String
  worker        User     @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  assignedBy    String   // userId of actor who made the assignment
  status        String   @default("ASSIGNED") // ASSIGNED, ACCEPTED, IN_PROGRESS, COMPLETED, REJECTED, REVOKED
  assignedAt    DateTime @default(now())
  acceptedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  rejectedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?
  rejectReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, workerUserId])
  @@index([companyId])
  @@index([workerUserId])
  @@index([jobId])
  @@index([status])
}
