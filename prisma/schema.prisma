  userId     String
  tokenHash  String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model FinancialLedger {
  id             String   @id @default(cuid())
  groupId        String?
  accountId      String
  accountType    String
  entryType      String
  amount         BigInt
  currency       String   @default("LKR")
  referenceType  String
  referenceId    String
  idempotencyKey String   @unique
  description    String?
  createdBy      String
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([accountId, accountType])
  @@index([referenceType, referenceId])
  @@index([groupId])
}

model IdempotencyRecord {
  id                String   @id @default(cuid())
  idempotencyKey    String   @unique
  userId            String?
  operation         String
  status            String   @default("PENDING")
  metadata          String?
  resultPayload     String?
  requestFingerprint String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([idempotencyKey])
  @@index([userId, operation])
}

// Phase 10.4 — Inspection lifecycle
model JobInspection {
  id                  String    @id @default(cuid())
  jobId               String
  job                 MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerType        String    // INDIVIDUAL, COMPANY
  taskerId            String?
  companyId           String?
  status              String    @default("REQUESTED") // REQUESTED, SCHEDULED, EN_ROUTE, ARRIVED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW, DISPUTED
  scheduledAt         DateTime?
  scheduledWindowStart String?  // e.g. "2026-09-15T09:00:00Z"
  scheduledWindowEnd  String?
  arrivedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  inspectionFeeCents  BigInt?
  currency            String    @default("LKR")
  diagnosisSummary    String?   // Provider submits after inspection
  scopeSummary        String?   // Recommended work scope
  materialsSummary    String?   // Materials required
  estimatedDuration   String?   // Estimated repair duration
  risksAndLimitations String?
  customerNotes       String?
  providerNotes       String?
  verifiedByCustomer  Boolean   @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  evidence            JobEvidence[]

  @@index([jobId])
  @@index([taskerId])
  @@index([companyId])
  @@index([status])
  @@index([providerType])
}

// Phase 10.4 — Change order lifecycle
model JobChangeOrder {
  id                    String    @id @default(cuid())
  jobId                 String
  job                   MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  baseQuoteId           String
  providerType          String    // INDIVIDUAL, COMPANY
  taskerId              String?
  companyId             String?
  reason                String
  scopeDelta            String?   // Description of additional work
  amountDeltaCents      BigInt    // Positive = additional cost
  currency              String    @default("LKR")
  status                String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, CANCELLED
  createdBy             String    // userId who created (provider)
  createdAt             DateTime  @default(now())
  submittedAt           DateTime?
  customerDecisionAt    DateTime?
  approvedByCustomerId  String?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  rejectionReason       String?
  revisionNumber        Int       @default(1)

  lineItems             JobChangeOrderLineItem[]

  @@index([jobId])
  @@index([baseQuoteId])
  @@index([taskerId])
  @@index([companyId])
  @@index([status])
  @@index([createdBy])
}

// Phase 10.4 — Change order line items (itemized deltas)
model JobChangeOrderLineItem {
  id                String    @id @default(cuid())
  changeOrderId     String
  changeOrder       JobChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  type              String    // LABOUR, MATERIALS, TAX, INSPECTION_FEE, OTHER
  description       String
  quantity          Float     @default(1)
  unit              String?
  unitAmountCents   BigInt
  totalAmountCents  BigInt
  currency          String    @default("LKR")
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())

  @@index([changeOrderId])
}

// Phase 10.4 — Evidence attached to inspections or jobs
model JobEvidence {
  id            String    @id @default(cuid())
  jobId         String
  job           MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inspectionId  String?
  inspection    JobInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  uploaderId    String    // userId of provider or customer
  uploaderType  String    // CUSTOMER, PROVIDER
  evidenceType  String    // PHOTO, VIDEO, NOTE, MEASUREMENT, DIAGNOSTIC
  url           String?
  description   String?
  mimeType      String?
  createdAt     DateTime  @default(now())

  @@index([jobId])
  @@index([inspectionId])
  @@index([uploaderId])
}

// Phase 10.4 — Anti-bypass risk events
model MarketplaceRiskEvent {
  id            String    @id @default(cuid())
  jobId         String?
  job           MarketplaceJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  actorUserId   String    // User who triggered the event
  eventType     String    // CONTACT_SHARE_ATTEMPT, OFF_PLATFORM_PAYMENT_LANGUAGE, PREMATURE_CONTACT_ACCESS, REPEATED_CANCELLATION_AFTER_MATCH, ABNORMAL_PRICE_ESCALATION
  severity      String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  metadata      String?   // JSON metadata (context, patterns detected)
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  resolution    String?   // CONFIRMED, DISMISSED, ESCALATED, NO_ACTION

  @@index([jobId])
  @@index([actorUserId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
}

model WalletBalance {
  id               String   @id @default(cuid())
  walletId         String
  walletType       String
  balance          BigInt   @default(0)
  availableBalance BigInt   @default(0)
  pendingBalance   BigInt   @default(0)
  currency         String   @default("LKR")
  version          Int      @default(1)
