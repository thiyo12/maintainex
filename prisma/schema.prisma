generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  mxId             String?  @unique // MXU-XXXXX unique user ID
  email            String   @unique
  passwordHash     String
  name             String
  phone            String?
  role             String   @default("CUSTOMER")
  isActive         Boolean  @default(true)
  emailVerified    Boolean  @default(false)
  isSuspended      Boolean  @default(false)
  isBanned         Boolean  @default(false) // Banned for off-platform deals
  banReason        String?
  suspendedUntil   DateTime?
  suspensionReason String?
  pushToken        String?
  lastNameChangedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions           Session[]
  otps               OTP[]
  loginActivities    LoginActivity[]
  bookings           Booking[]
  reviews            Review[]
  customerProfile    CustomerProfile?
  taskerProfile      TaskerProfile?
  jobPostings        JobPosting[]
  taskerReviewsGiven TaskerReview[]
  notifications      Notification[]
  conversations      ConversationParticipant[]
  messagesSent       Message[]
  disputes           Dispute[]
  companyProfile     CompanyProfile?
  teamMembers        TeamMember[]
  payouts            Payout[]
  identityDocs       IdentityDocument[]
  identityStatus     String               @default("NOT_SUBMITTED")
  userDevices        UserDevice[]
  fraudEvents        FraudEvent[]
  adminFlags         AdminFlag[]
  offerBookings      OfferBooking[]
  payoutRequests     PayoutRequest[]
}

model Admin {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String?
  role            String   @default("ADMIN")
  province        String?
  region          String   @default("LK")
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  canEditServices Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  isValid   Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OTP {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   String
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginActivity {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  ipAddress    String
  userAgent    String
  location     String?
  isNewIP      Boolean  @default(false)
  isNewDevice  Boolean  @default(false)
  isSuspicious Boolean  @default(false)
  reason       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([isSuspicious])
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  icon         String?
  image        String?
  coverImage   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  services Service[]
}

model Industry {
  id           String   @id @default(cuid())
  name         String
  icon         String?
  image        String?
  displayOrder Int      @default(0)
  isPartner    Boolean  @default(false)
  partnerName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String?
  description      String
  shortDescription String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  price            Float
  duration         Int
  features         String
  image            String?
  displayOrder     Int      @default(0)
  views            Int      @default(0)
  isTrending       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  bookings Booking[]
  reviews  Review[]

  @@index([categoryId])
  @@index([views])
  @@index([isTrending])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  phone     String?
  location  String?
  districts String?
  province  String?
  region    String   @default("LK")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  bookings     Booking[]
  admins       Admin[]
  applications Application[]
  staff        Staff[]
  vacancies    JobVacancy[]
  invoices     Invoice[]
  quotations   Quotation[]

  @@index([city])
}

model Booking {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id])
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  date          DateTime
  timeSlot      String
  status        String         @default("PENDING")
  notes         String?
  totalPrice    Float
  budgetMin     Float?
  budgetMax     Float?
  name          String?
  phone         String?
  email         String?
  district      String?
  province      String?
  region        String         @default("LK")
  address       String?
  time          String?
  taskerId      String?
  tasker        TaskerProfile? @relation(fields: [taskerId], references: [id], onDelete: SetNull)
  templateJobId String?
  templateJob   TemplateJob?   @relation(fields: [templateJobId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([branchId])
  @@index([taskerId])
  @@index([templateJobId])
  @@index([status])
  @@index([date])
}

model Application {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  service    String
  experience String
  resumeUrl  String?
  cvUrl      String?
  status     String   @default("PENDING")
  notes      String?
  district   String?
  province   String?
  address    String?
  position   String?
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([branchId])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  status       String   @default("PENDING")
  customerName String?
  createdAt    DateTime @default(now())

  @@index([serviceId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // number, boolean, string, json
  label     String   @default("")
  description String @default("")
  groupName String   @default("general")
  updatedBy String?
  updatedAt DateTime?
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string") // number, boolean, string, json
  label       String   @default("")
  description String   @default("")
  groupName   String   @default("general")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([groupName])
}

model JobMatchQueue {
  id          String    @id @default(cuid())
  jobId       String
  job         MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskerId    String
  tasker      TaskerProfile  @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  score       Float
  rank        Int
  wave        Int?
  status      String    @default("pending") // pending, notified, accepted, declined, expired
  notifiedAt  DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([jobId, taskerId])
  @@index([jobId, status])
  @@index([jobId, wave, status])
  @@index([taskerId])
}

model OfferMatchQueue {
  id          String    @id @default(cuid())
  bookingId   String
  booking     OfferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  taskerId    String
  tasker      TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  score       Float
  rank        Int
  status      String    @default("pending") // pending, notified, accepted, declined, expired
  notifiedAt  DateTime?
  expiresAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([bookingId, taskerId])
  @@index([bookingId, status])
  @@index([expiresAt, status])
  @@index([taskerId])
}

model TaskerBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  label      String
  awardedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model FraudEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminFlag {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("pending") // pending, reviewed, resolved, dismissed
  resolvedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, status])
  @@index([userId])
  @@index([status])
}

model UserDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  platform   String    // ios, android
  pushToken  String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([userId])
  @@index([userId, userAgent])
}

model OfferTemplate {
  id               String   @id @default(cuid())
  categoryId       String
  title            String
  description      String
  priceLkr         Int
  scopeNotes       String?
  isRemote         Boolean  @default(false)
  availabilityLabel String  @default("Today")
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  photoUrl         String?
  enrolledCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments OfferEnrollment[]
  bookings    OfferBooking[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model OfferEnrollment {
  id           String   @id @default(cuid())
  templateId   String
  template     OfferTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  taskerId     String
  tasker       TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  status       String   @default("active") // active, paused, withdrawn
  enrolledAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([templateId, taskerId])
  @@index([templateId])
  @@index([taskerId])
}

model OfferBooking {
  id              String    @id @default(cuid())
  templateId      String
  template        OfferTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taskerId        String?
  currentTaskerId String?
  scheduledAt     DateTime
  latitude        Float?
  longitude       Float?
  status          String    @default("pending") // pending, finding, accepted, in_progress, completed, no_tasker_available, cancelled
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  matchQueue OfferMatchQueue[]

  @@index([templateId])
  @@index([customerId])
  @@index([taskerId])
  @@index([status])
}

model PayoutRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  currency   String   @default("LKR")
  method     String   @default("bank") // bank, wallet
  status     String   @default("pending") // pending, processing, completed, failed
  notes      String?
  processedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ActivityLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  adminName   String?
  branchId    String?
  action      String
  entityType  String
  entityId    String?
  description String
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// CRM MODELS - Customer Relationship Management
// ============================================

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Customer Classification
  customerType String @default("REGULAR") // REGULAR, VIP, CORPORATE, POTENTIAL
  status       String @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED

  // Preferences
  preferredContact String? // EMAIL, PHONE, WHATSAPP
  smsOptIn         Boolean @default(true)
  emailOptIn       Boolean @default(true)
  whatsappOptIn    Boolean @default(true)

  // Source tracking
  source        String? // WEBSITE, REFERRAL, CAMPAIGN, WALK_IN
  sourceDetails String?

  // Lifetime value
  totalBookings Int   @default(0)
  totalSpent    Float @default(0)
  lifetimeValue Float @default(0)

  // First & last interactions
  firstBooking DateTime?
  lastBooking  DateTime?

  // Notes & blacklist
  summary         String? // Short summary/notes about customer
  blacklistReason String?
  blacklistDate   DateTime?

  // Province (for query performance and province-based access)
  province String?

  // Metadata
  metadata String? // JSON for additional data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tags           CustomerTag[]
  addresses      CustomerAddress[]
  activities     CustomerActivity[]
  notes          CustomerNote[]
  communications CustomerCommunication[]
  segments       CustomerSegmentCustomer[]

  @@index([userId])
  @@index([customerType])
  @@index([status])
  @@index([province])
  @@index([createdAt])
}

model CustomerTag {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  color       String  @default("#6366f1") // Hex color for UI
  description String?

  // Tag type
  type String @default("GENERAL") // GENERAL, BEHAVIOR, VALUE, PREFERENCE

  // Usage stats
  usageCount Int @default(0)

  isSystem Boolean @default(false) // System tags can't be deleted
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers CustomerProfile[]

  @@index([name])
  @@index([type])
}

model CustomerSegment {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  // Segment criteria (JSON)
  criteria String // {"province": "Western", "minBookings": 3}

  // Segment type
  type String @default("DYNAMIC") // DYNAMIC, STATIC

  // Stats
  memberCount Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers CustomerSegmentCustomer[]

  @@index([name])
  @@index([type])
}

model CustomerSegmentCustomer {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())
  addedBy String? // Admin ID who added

  @@unique([customerId, segmentId])
  @@index([customerId])
  @@index([segmentId])
}

model CustomerAddress {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label        String // Home, Office, Other
  address      String
  district     String
  province     String
  postalCode   String?
  instructions String? // Delivery/access instructions

  // Contact person at address
  contactName  String?
  contactPhone String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CustomerNote {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  content String
  type    String @default("GENERAL") // GENERAL, COMPLAINT, FEEDBACK, INTERNAL

  // Author tracking
  createdById   String?
  createdByName String?

  isPrivate Boolean @default(false) // Private notes only visible to creator

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdById])
}

model CustomerActivity {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type String // BOOKING_CREATED, BOOKING_COMPLETED, CALL_MADE, CALL_RECEIVED, 
  // EMAIL_SENT, EMAIL_OPENED, WHATSAPP_SENT, WHATSAPP_RECEIVED,
  // NOTE_ADDED, TAG_ADDED, TAG_REMOVED, SEGMENT_ADDED, SEGMENT_REMOVED,
  // STATUS_CHANGED, PROFILE_UPDATED, ADDRESS_ADDED, LOGIN

  // Activity details
  title       String
  description String?
  metadata    String? // JSON for additional data

  // Related entities
  relatedId   String? // Booking ID, etc.
  relatedType String? // BOOKING, SERVICE, etc.

  // Author tracking
  createdById    String?
  createdByName  String?
  createdByEmail String?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model CustomerCommunication {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Communication details
  channel   String // EMAIL, SMS, WHATSAPP, NOTIFICATION, CALL
  direction String // OUTBOUND, INBOUND

  subject String?
  content String

  // Status tracking
  status        String  @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED, CANCELLED
  statusDetails String?

  // External reference
  externalId     String? // Third-party message ID (WhatsApp message ID, etc.)
  externalStatus String? // Status from WhatsApp API, etc.

  // Sending details
  sentById    String?
  sentByEmail String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  // Template reference
  templateId   String?
  templateName String?

  // Metadata
  metadata String? // JSON for additional data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([channel])
  @@index([direction])
  @@index([status])
  @@index([sentById])
  @@index([createdAt])
}

// ============================================
// SECURITY MODELS
// ============================================

model SecurityAudit {
  id String @id @default(cuid())

  // Action details
  action   String // LOGIN, LOGOUT, VIEW, CREATE, UPDATE, DELETE, EXPORT, API_CALL
  category String // AUTH, CUSTOMER, BOOKING, SERVICE, REPORT, ADMIN, SYSTEM

  // Who
  userId       String?
  userEmail    String?
  userRole     String?
  userProvince String?

  // What
  entityType String?
  entityId   String?
  entityName String?

  // Details
  description String @default("")
  details     String? // JSON of additional context
  oldValue    String? // JSON of previous state
  newValue    String? // JSON of new state

  // Context
  ipAddress String?
  userAgent String?
  sessionId String?

  // Result
  success      Boolean @default(true)
  errorMessage String?

  // Risk assessment
  riskLevel    String  @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  isSuspicious Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([category])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([ipAddress])
  @@index([isSuspicious])
  @@index([createdAt])
  @@index([riskLevel])
}

model ApiKey {
  id   String @id @default(cuid())
  name String
  key  String @unique // Hashed version

  // Key metadata (unhashed prefix stored for identification)
  prefix  String // First 8 chars of key for identification
  version Int    @default(1)

  // Permissions
  permissions String // READ, WRITE, DELETE, ADMIN

  // Scoping
  scope    String  @default("FULL") // FULL, CUSTOMERS, BOOKINGS, REPORTS
  province String? // If set, key only works for this province

  // Status
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  lastIp     String?

  // Usage limits
  rateLimit    Int @default(100) // Requests per minute
  requestCount Int @default(0)

  // Owner
  createdById    String
  createdByEmail String
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([createdById])
  @@index([isActive])
}

model RateLimitLog {
  id String @id @default(cuid())

  // What was rate limited
  identifier String // IP address, API key, or user ID
  type       String // IP, API_KEY, USER, login, api, upload, password-reset, login-failed

  // Endpoint
  endpoint String @default("")
  method   String @default("")

  // Request details
  requestCount Int @default(1)

  // Window
  windowStart DateTime @default(now())
  windowEnd   DateTime @default(now())

  // Result
  limited    Boolean   @default(false)
  blockUntil DateTime?

  createdAt DateTime @default(now())

  @@index([identifier, windowStart])
  @@index([identifier, type, createdAt])
  @@index([limited])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model IpBlock {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ip])
  @@index([expiresAt])
}

model FailedLogin {
  id String @id @default(cuid())

  // Who tried to login
  email     String
  ipAddress String
  userAgent String?

  // Attempt details
  attemptCount Int       @default(1)
  blocked      Boolean   @default(false)
  blockUntil   DateTime?

  // Why it failed
  reason String? // INVALID_PASSWORD, INVALID_OTP, ACCOUNT_LOCKED, etc.

  // Location
  location String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, ipAddress])
  @@index([blocked])
  @@index([createdAt])
}

model DataExport {
  id String @id @default(cuid())

  // Export details
  type   String // CUSTOMERS, BOOKINGS, REPORTS, FULL
  format String @default("CSV") // CSV, JSON, EXCEL

  // Filters applied
  filters String? // JSON of filters used

  // File info
  fileName String?
  fileSize Int?
  filePath String?

  // Status
  status   String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress Int    @default(0)

  // Requester
  requestedById    String
  requestedByEmail String

  // Download
  downloadUrl String?
  expiresAt   DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
}

// Job Vacancies for Careers page
model JobVacancy {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  isActive    Boolean  @default(true)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([branchId])
}

// Staff managed by branch admins
model Staff {
  id        String   @id @default(cuid())
  staffId   String   @unique // Auto-generated: EMP-001, EMP-002...
  name      String
  phone     String?
  email     String?
  position  String?
  photo     String?
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([staffId])
}

model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique
  type            String    @default("INVOICE")
  branchId        String
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  subtotal        Float
  tax             Float     @default(0)
  total           Float
  status          String    @default("DRAFT")
  paymentStatus   String    @default("UNPAID")
  amountPaid      Float     @default(0)
  dueDate         DateTime?
  notes           String?
  createdBy       String
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  branch Branch        @relation(fields: [branchId], references: [id])
  items  InvoiceItem[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  totalPrice  Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique
  type            String   @default("QUOTATION")
  branchId        String
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  validUntil      DateTime
  status          String   @default("DRAFT")
  notes           String?
  createdBy       String
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch          @relation(fields: [branchId], references: [id])
  items  QuotationItem[]
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  totalPrice  Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ============================================
// JOB SECTION — CATEGORIES & TEMPLATE JOBS
// ============================================

model JobCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  iconName  String
  colorHex  String
  sortOrder Int      @default(0)
  countries String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  jobs TemplateJob[]

  @@index([sortOrder])
  @@index([isActive])
}

model TemplateJob {
  id                     String      @id @default(cuid())
  categoryId             String
  category               JobCategory @relation(fields: [categoryId], references: [id])
  name                   String
  description            String
  whatIsIncluded         String
  typicalDurationMinutes Int
  priceMin               Float
  priceMax               Float
  currency               String      @default("LKR")
  isPopular              Boolean     @default(false)
  isCompanyOnly          Boolean     @default(false)
  countries              String
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())

  taskerSkills      TaskerSkill[]
  bookings          Booking[]
  seasonalOfferJobs SeasonalOfferJob[]

  @@index([categoryId])
  @@index([isPopular])
  @@index([isActive])
}

model TaskerSkill {
  id              String        @id @default(cuid())
  taskerId        String
  tasker          TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  jobId           String
  job             TemplateJob   @relation(fields: [jobId], references: [id])
  experienceYears Int           @default(0)
  hourlyRate      Float         @default(0)
  fixedRate       Float         @default(0)
  currency        String        @default("LKR")

  @@unique([taskerId, jobId])
  @@index([taskerId])
  @@index([jobId])
}

model CompanySpecialty {
  id         String         @id @default(cuid())
  companyId  String
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId String?
  jobId      String?

  @@index([companyId])
  @@index([categoryId])
  @@index([jobId])
}

// ============================================
// MOBILE MARKETPLACE MODELS
// ============================================

model TaskerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mxId              String?  @unique // MXT-XXXXX unique tasker ID
  verificationStatus String  @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNote  String?  // Admin rejection reason
  verifiedBy        String?  // Admin ID who verified
  verifiedAt        DateTime?

  bio           String?
  hourlyRate    Float    @default(0)
  skills        String? // Category slugs
  serviceAreas  String? // District names
  rating        Float    @default(0)
  completedJobs Int      @default(0)
  isVerified    Boolean  @default(false)
  isOnline      Boolean  @default(false)
  profileImage  String?

  // Experience proof
  experienceProofUrl String? // Certificate or portfolio URL
  hasDrivingLicense  Boolean @default(false)
  drivingLicenseUrl  String?

  // Reputation & scoring
  compositeScore  Int     @default(50)
  penaltyPoints   Int     @default(0)
  completionRate  Int     @default(100)
  avgResponseMin  Int     @default(60)
  scoreUpdatedAt  DateTime?

  // Location
  latitude          Float?
  longitude         Float?
  serviceRadius     Float?
  locationUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids            Bid[]
  assignments     Assignment[]
  reviews         TaskerReview[]
  taskerSkills    TaskerSkill[]
  bookings        Booking[]
  matchQueue      JobMatchQueue[]
  offerMatchQueue OfferMatchQueue[]
  enrollments     OfferEnrollment[]

  @@index([isOnline])
  @@index([isVerified])
  @@index([rating])
  @@index([compositeScore])
}

model JobPosting {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title         String
  description   String
  category      String // Category slug
  budget        Float
  location      String // District or address
  latitude      Float?
  longitude     Float?
  isRemote      Boolean   @default(false)
  scheduledDate DateTime?
  status        String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids        Bid[]
  assignments Assignment[]
  disputes    Dispute[]

  @@index([customerId])
  @@index([status])
  @@index([category])
  @@index([location])
  @@index([createdAt])
}

model Bid {
  id       String        @id @default(cuid())
  jobId    String
  job      JobPosting    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskerId String
  tasker   TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  amount  Float
  message String?
  status  String  @default("PENDING") // PENDING, ACCEPTED, REJECTED

  createdAt DateTime @default(now())

  @@unique([jobId, taskerId])
  @@index([jobId])
  @@index([taskerId])
  @@index([status])
}

model Assignment {
  id       String        @id @default(cuid())
  jobId    String
  job      JobPosting    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskerId String
  tasker   TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  status      String    @default("ASSIGNED") // ASSIGNED, EN_ROUTE, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([taskerId])
  @@index([status])
}

model TaskerReview {
  id         String        @id @default(cuid())
  taskerId   String
  tasker     TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation(fields: [reviewerId], references: [id])

  jobId   String?
  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([taskerId])
  @@index([reviewerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  data      String? // JSON payload
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ============================================
// MOBILE CHAT MODELS
// ============================================

model Conversation {
  id        String   @id @default(cuid())
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ============================================
// MOBILE DISPUTE MODELS
// ============================================

model Dispute {
  id          String     @id @default(cuid())
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User       @relation(fields: [raisedById], references: [id])
  reason      String
  description String
  resolution  String?
  status      String     @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([jobId])
  @@index([raisedById])
  @@index([status])
}

// ============================================
// COMPANY MODELS
// ============================================

model CompanyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mxId              String?  @unique // MXC-XXXXX unique company ID
  companyName       String
  registrationNo    String?
  taxId             String?  // Tax identification number
  description       String?
  services          String
  serviceAreas      String
  rating            Float    @default(0)
  completedProjects Int      @default(0)
  isVerified        Boolean  @default(false)
  logo              String?

  // Verification
  verificationStatus String  @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNote   String? // Admin rejection reason
  verifiedBy         String? // Admin ID who verified
  verifiedAt         DateTime?
  businessRegDocUrl  String? // Business registration document URL

  // Staff requirements
  minStaffCount  Int     @default(3) // Minimum staff required
  staffCount     Int     @default(0) // Actual staff count
  staffProofUrl  String? // Proof of staff (document URL)

  // Location
  latitude          Float?
  longitude         Float?
  serviceRadius     Float?

  commissionRate        Float     @default(10.0) // Changed from 15 to 10
  subscriptionStatus    String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  subscriptionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts     Contract[]
  teamMembers   TeamMember[]
  specialties   CompanySpecialty[]
  invites       TeamInvite[]
  subscriptions CompanySubscription[]

  @@index([isVerified])
  @@index([rating])
  @@index([subscriptionStatus])
}

model TeamMember {
  id        String         @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  name          String
  role          String
  skills        String
  isOnline      Boolean  @default(false)
  rating        Float    @default(0)
  completedJobs Int      @default(0)
  joinedAt      DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([companyId])
}

model TeamInvite {
  id        String         @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email     String?
  phone     String?
  name      String
  role      String   @default("MEMBER") // MEMBER, ADMIN
  token     String   @unique
  status    String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, CANCELLED
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([token])
  @@index([status])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String?
  features    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions CompanySubscription[]
}

model CompanySubscription {
  id        String           @id @default(cuid())
  companyId String
  company   CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  status    String           @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  startDate DateTime         @default(now())
  endDate   DateTime?
  autoRenew Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([companyId])
  @@index([planId])
  @@index([status])
}

model Contract {
  id          String         @id @default(cuid())
  companyId   String
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientName  String
  title       String
  description String?
  value       Float
  status      String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  progress    Int            @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  milestones Milestone[]

  @@index([companyId])
  @@index([status])
}

model Milestone {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  status      String    @default("PENDING") // PENDING, APPROVED, IN_REVIEW
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([contractId])
  @@index([status])
}

// ============================================
// EARNINGS & PAYOUT MODELS
// ============================================

model Payout {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      BigInt
  description String?
  status      String    @default("PENDING") // PENDING, CLEARED, FAILED
  source      String // JOB, CONTRACT, MILESTONE
  sourceId    String? // Job ID, Contract ID, etc.
  createdAt   DateTime  @default(now())
  clearedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// FLASH OFFERS — Landing page promotions
// ============================================

model FlashOffer {
  id            String  @id @default(cuid())
  title         String
  description   String?
  discountType  String // PERCENTAGE or FLAT
  discountValue Float
  couponCode    String?
  linkUrl       String?
  badgeText     String  @default("🔥 FLASH")
  bgColor       String  @default("#FFC300")
  textColor     String  @default("#1a1a1a")

  startsAt  DateTime
  expiresAt DateTime

  maxClaims     Int @default(50)
  currentClaims Int @default(0)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([expiresAt])
}

// ============================================
// SEASONAL OFFERS — Country + season-based promotions
// ============================================

model SeasonalOffer {
  id            String  @id @default(cuid())
  title         String
  description   String?
  slug          String  @unique
  season        String  // "winter" | "spring" | "summer" | "fall" | "general"
  country       String  // "LK" | "CA"
  image         String?
  badgeText     String?
  bgColor       String?
  textColor     String?
  displayOrder  Int     @default(0)
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs SeasonalOfferJob[]

  @@index([season, country])
  @@index([isActive])
}

model SeasonalOfferJob {
  id              String        @id @default(cuid())
  seasonalOfferId String
  seasonalOffer   SeasonalOffer @relation(fields: [seasonalOfferId], references: [id], onDelete: Cascade)
  templateJobId   String
  templateJob     TemplateJob   @relation(fields: [templateJobId], references: [id])
  price           Float?
  currency        String        @default("LKR")

  @@unique([seasonalOfferId, templateJobId])
  @@index([templateJobId])
}

// ============================================
// MARKETPLACE V2 — Job Marketplace System
// ADD-ONLY — Does not affect existing tables
// Scalar foreign keys only — no Prisma relations
// to avoid modifying User/JobCategory models
// ============================================

model Country {
  id   String @id @default(cuid())
  name String
  code String @unique

  states State[]

  @@index([code])
}

model State {
  id        String  @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  cities City[]

  @@index([countryId])
}

model City {
  id      String @id @default(cuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  areas Area[]

  @@index([stateId])
}

model Area {
  id     String @id @default(cuid())
  name   String
  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  @@index([cityId])
}

model MarketplaceJob {
  id               String    @id @default(cuid())
  customerId       String
  title            String
  description      String
  categoryId       String
  photos           String
  budgetType       String // FIXED, HOURLY, NEGOTIABLE, REQUEST_QUOTES
  budgetAmount     BigInt
  areaId           String?
  postalCode       String?
  preferredDate    DateTime?
  addressStreet    String? // Only shared after escrow payment
  addressBuilding  String?
  addressApartment String?
  addressLandmark  String?
  addressSharedAt  DateTime?
  latitude         Float?
  longitude        Float?
  urgency          String    @default("normal") // normal, urgent, emergency
  estimatedDuration Float?                       // Estimated hours
  workersCount     Int       @default(1)
  status           String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  isActive         Boolean   @default(true)
  aiEstimateJson   String?   // JSON-encoded AI price estimate
  materialHandling String?   // tasker_brings, customer_provides, quote_both
  currentWave      Int       @default(0)
  waveSentAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  matchQueue JobMatchQueue[]

  @@index([customerId])
  @@index([categoryId])
  @@index([areaId])
  @@index([status])
  @@index([createdAt])
}

model JobQuote {
  id                      String   @id @default(cuid())
  jobId                   String
  providerId              String
  providerType            String // INDIVIDUAL, COMPANY
  price                   BigInt

  estimatedCompletionTime String
  message                 String?
  attachments             String
  status                  String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([jobId])
  @@index([providerId])
  @@index([status])
}

model JobEscrow {
  id            String    @id @default(cuid())
  jobId         String
  quoteId       String
  customerId    String
  providerId    String
  amount        BigInt // quote price in cents
  serviceFee    BigInt // platform fee in cents
  totalAmount   BigInt // amount + fee in cents
  paymentMethod String    @default("CARD") // CARD, CASH
  status        String    @default("PENDING") // PENDING, PROTECTED, ON_HOLD, RELEASED, REFUNDED
  heldAt        DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?
  cashConfirmedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([jobId])
  @@index([customerId])
  @@index([providerId])
  @@index([status])
}

model CommissionSettlement {
  id               String    @id @default(cuid())
  jobId            String
  escrowId         String
  providerId       String
  customerId       String
  jobAmount        BigInt // total job amount in cents (excl. fees)
  commissionRate   Float    @default(10.0) // Changed from 15 to 10
  commissionAmount BigInt // jobAmount * commissionRate / 10000 (bps calc)
  status           String   @default("PENDING") // PENDING, SETTLED
  settledAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([jobId])
  @@index([providerId])
  @@index([status])
}

model JobOtp {
  id          String    @id @default(cuid())
  jobId       String    @unique
  otp         String // 4-digit code
  generatedAt DateTime  @default(now())
  verifiedAt  DateTime?

  @@index([jobId])
}

model ProviderWallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  isFrozen         Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model CustomerWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  isFrozen  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  walletType    String // PROVIDER, CUSTOMER
  type          String // CREDIT, DEBIT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String
  referenceType String // ESCROW_RELEASE, ESCROW_REFUND, WITHDRAWAL, SERVICE_FEE
  referenceId   String?
  status        String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([walletType])
  @@index([referenceType])
  @@index([createdAt])
}

model JobWorkspace {
  id             String   @id @default(cuid())
  jobId          String   @unique
  progressStatus String   @default("ACCEPTED") // ACCEPTED, IN_PROGRESS, WAITING_CUSTOMER, COMPLETION_REQUESTED, COMPLETED, DISPUTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([jobId])
}

model JobReview {
  id            String   @id @default(cuid())
  jobId         String
  customerId    String
  providerId    String
  quality       Int // 1-5
  communication Int // 1-5
  timeliness    Int // 1-5
  comment       String?
  createdAt     DateTime @default(now())

  @@unique([jobId, customerId])
  @@index([providerId])
}

model ProviderReview {
  id                String   @id @default(cuid())
  jobId             String
  providerId        String
  customerId        String
  cooperation       Int // 1-5
  communication     Int // 1-5
  overallExperience Int // 1-5
  comment           String?
  createdAt         DateTime @default(now())

  @@unique([jobId, providerId])
  @@index([customerId])
}

model IdentityDocument {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  docType    String    // PASSPORT, NATIONAL_ID, DRIVERS_LICENSE
  side       String    // FRONT or BACK
  imageUrl   String
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// ADMIN PANEL MODELS
// ============================================

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  role                String    @default("ADMIN")
  firstName           String
  lastName            String
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  totpVerifiedAt      DateTime?
  assignedCountries   String  @default("")
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  parentId            String?
  createdBy           String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@index([parentId])
}

model AdminNotification {
  id            String   @id @default(cuid())
  adminUserId   String
  type          String
  title         String
  message       String
  link          String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([adminUserId, read])
  @@index([createdAt])
}

model AdminRefreshToken {
  id                String    @id @default(cuid())
  adminUserId       String
  tokenHash         String    @unique
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([tokenHash])
  @@index([adminUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminEmail  String
  adminRole   String
  action      String
  targetTable String?
  targetId    String?
  targetLabel String?
  oldValue    String?
  newValue    String?
  ipAddress   String
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetTable, targetId])
  @@index([action, createdAt])
}

/// Admin login attempt tracking with lockout
model AdminLoginAttempt {
  id            String    @id @default(cuid())
  adminUserId   String?
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime  @default(now())

  @@index([email, createdAt])
  @@index([adminUserId, createdAt])
}

/// Admin session tracking (replaces AdminRefreshToken for JWT auth)
model AdminSession {
  id                String    @id @default(cuid())
  adminUserId       String
  refreshTokenHash  String    @unique
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  lastUsedAt        DateTime?
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([adminUserId])
  @@index([refreshTokenHash])
}

/// Work queue — auto-created on KYC/dispute/settlement/flagged-job events
model AdminAlert {
  id           String    @id @default(cuid())
  type         String    // fraud, dispute, payout, system, kyc, settlement, flagged_job
  severity     String    // critical, high, medium, low
  title        String
  description  String?
  targetTable  String?
  targetId     String?
  assignedTo   String?   // staff admin user ID (null = unassigned)
  assignedRole String?   // which role should handle this: USER_MANAGEMENT, SUPPORT, FINANCE, MANAGER
  priority     String    @default("medium") // urgent, high, medium, low
  notes        String?   // staff comments / resolution notes
  status       String    @default("open") // open, in_progress, resolved, dismissed
  slaMinutes   Int?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, severity])
  @@index([type, createdAt])
  @@index([assignedTo, status])
  @@index([assignedRole, status])
  @@index([status, priority, createdAt])
}

model PlatformSettings {
  id                String   @id @default(cuid())
  platformFeeBps    Int      @default(1000) // 10% = 1000 basis points
  minJobAmountCents BigInt   @default(500)
  maxJobAmountCents BigInt   @default(1000000)
  escrowReleaseDays Int      @default(3)
  maxActiveJobsPerUser Int   @default(10)
  maxQuotesPerJob   Int      @default(10)
  maxDisputesPerJob Int      @default(1)
  autoReleaseAfterDays Int   @default(14)
  commissionRate    Float    @default(10.0) // Platform commission percentage
  weeklySettlementDay String @default("MONDAY") // Day commission is due
  suspensionGracePeriodDays Int @default(7) // Days after due before suspension
  supportEmail      String?
  updatedBy         String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model RealEstateListing {
  id              String   @id @default(cuid())
  postedBy        String
  title           String
  description     String?

  // Property details
  type            String   @default("sale")      // legacy: sale, rent, commercial, land
  propertyType    String   @default("house")    // house, apartment, commercial, land, rental
  purpose         String   @default("sale")      // sale, rent, commercial, land

  // Pricing
  priceLkr        Float    @default(0)
  pricePer        String?                        // null=sale, month/year=rent

  // Location (hierarchical, text-based)
  countryCode     String   @default("LK")
  district        String?
  city            String?
  area            String?
  address         String?
  latitude        Float?
  longitude       Float?

  // Property specs
  bedrooms        Int?
  bathrooms       Int?
  parking         Int?
  areaSqft        Int?
  propertySize    Int?                          // sqft
  landSize        Int?                          // sqft for land
  yearBuilt       Int?
  isFurnished     Boolean  @default(false)
  isNewProperty   Boolean  @default(true)       // new or used

  // Media
  photos          String?                        // JSON array
  amenities       String?                        // JSON array stored as string (SQLite)
  videoUrl        String?

  // Seller info
  contactPhone    String?
  contactName     String?

  // Approval workflow
  status          String   @default("draft")    // draft, pending, approved, rejected, published
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  // Boost/Featured
  isFeatured      Boolean  @default(false)
  boostTier       String?                        // null, basic, premium, top
  boostExpiresAt  DateTime?
  boostedAt       DateTime?

  // Analytics
  views           Int      @default(0)
  saves           Int      @default(0)
  inquiries       Int      @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([postedBy])
  @@index([status])
  @@index([countryCode, district])
  @@index([propertyType, purpose])
  @@index([isFeatured, boostTier])
  @@index([createdAt])
}

model PropertyFavorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model PropertyInquiry {
  id          String   @id @default(cuid())
  listingId   String
  buyerId     String
  sellerId    String
  type        String   // chat, call, inquiry, viewing
  message     String?
  status      String   @default("pending") // pending, responded, closed
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
}

model PropertyBoost {
  id            String   @id @default(cuid())
  listingId     String
  userId        String
  tier          String   // basic, premium, top
  amount        Float
  currency      String
  paymentMethod String   // wallet, card
  status        String   @default("active") // active, expired
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([listingId])
  @@index([userId])
}

model PropertyLocation {
  id          String   @id @default(cuid())
  countryCode String
  district    String
  city        String
  area        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  @@index([countryCode, district])
}

/// Stores per-category/per-country pricing model weights for AI price estimation
model PricingModel {
  id                   String   @id @default(cuid())
  categoryId           String
  countryCode          String                        // LK, CA
  baseRate             Float     @default(0)         // Base hourly/service rate
  complexityMultiplier Float     @default(1.0)       // Complexity adjustment factor
  urgencyMultiplier    Float     @default(1.0)       // Urgency surcharge multiplier
  weekendMultiplier    Float     @default(1.0)       // Weekend/holiday surcharge
  nightMultiplier      Float     @default(1.0)       // Night time surcharge
  travelCostPerKm      Float     @default(0)         // Cost per km travel
  materialCostFactor   Float     @default(0)         // Material cost as % of base
  demandMultiplier     Float     @default(1.0)       // Demand-based adjustment
  confidence           Float     @default(0.5)       // Model confidence (0-1)
  modelVersion         Int       @default(1)
  trainedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([categoryId, countryCode])
  @@index([countryCode])
}

/// Cached completed job prices for training the pricing model
model HistoricalJobPrice {
  id             String   @id @default(cuid())
  jobId          String   @unique
  categoryId     String
  countryCode    String
  cityId         String?
  areaId         String?
  finalPrice     Float                              // Actual completed price
  estimatedPrice Float?                             // Price estimated by system
  budgetAmount   Float                              // Budget set when posting
  complexity     String   @default("medium")        // simple, medium, complex
  urgency        String   @default("normal")        // normal, urgent, emergency
  duration       Float?                             // Estimated hours
  workersCount   Int      @default(1)
  travelDistance Float?                             // Km traveled
  isWeekend      Boolean  @default(false)
  isHoliday      Boolean  @default(false)
  isNight        Boolean  @default(false)
  materialCost   Float?                             // Material cost if applicable
  completedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([categoryId, countryCode])
  @@index([cityId])
  @@index([areaId])
  @@index([completedAt])
}

/// Average market price per category per city/area for fast lookup
model RegionalPriceIndex {
  id            String   @id @default(cuid())
  categoryId    String
  countryCode   String
  cityId        String?
  areaId        String?
  avgPrice      Float    @default(0)
  minPrice      Float    @default(0)
  maxPrice      Float    @default(0)
  medianPrice   Float    @default(0)
  sampleSize    Int      @default(0)
  demandLevel   String   @default("normal")         // low, normal, high, surge
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([categoryId, countryCode, cityId, areaId])
  @@index([countryCode])
}

/// Fast lookup cache for price estimates (TTL-based expiry)
model PricingCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  response  String                                // JSON string of PriceEstimate
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Provider work hours, days, and vacation status (Engine 10)
model ProviderAvailability {
  id             String   @id @default(cuid())
  providerId     String
  providerType   String                       // INDIVIDUAL, COMPANY
  monday         Boolean  @default(true)
  tuesday        Boolean  @default(true)
  wednesday      Boolean  @default(true)
  thursday       Boolean  @default(true)
  friday         Boolean  @default(true)
  saturday       Boolean  @default(true)
  sunday         Boolean  @default(false)
  startTime      String   @default("08:00")   // HH:mm
  endTime        String   @default("18:00")   // HH:mm
  vacationStart  DateTime?
  vacationEnd    DateTime?
  isAvailable    Boolean  @default(true)
  lastUpdated    DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([providerId])
  @@index([isAvailable])
}

/// Predicted demand per category per area per day (Engine 8)
model DemandForecast {
  id            String   @id @default(cuid())
  categoryId    String
  countryCode   String
  cityId        String?
  areaId        String?
  forecastDate  DateTime
  demandScore   Float    @default(0)         // 0-100
  supplyScore   Float    @default(0)         // 0-100
  ratio         Float    @default(1.0)       // demand/supply
  demandLevel   String   @default("normal")  // low, normal, high, surge
  jobCount      Int      @default(0)
  searchCount   Int      @default(0)
  providerCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([categoryId, countryCode, forecastDate])
  @@index([areaId, forecastDate])
}

/// User search logs for recommendation learning (Engine 9)
model SearchLog {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  categoryMatch String?
  confidence   Float?
  clickedId    String?                      // What they clicked
  countryCode  String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Auto-computed provider quality scores (Engine 11)
model QualityMetric {
  id                  String   @id @default(cuid())
  providerId          String
  providerType        String
  qualityScore        Float    @default(50)  // 0-100
  avgReviewRating     Float    @default(0)
  jobCompletionRate   Float    @default(100) // percentage
  onTimeRate          Float    @default(100) // percentage
  disputeRate         Float    @default(0)   // percentage
  totalJobs           Int      @default(0)
  completedJobs       Int      @default(0)
  disputedJobs        Int      @default(0)
  totalReviews        Int      @default(0)
  warningsIssued      Int      @default(0)
  isFlagged           Boolean  @default(false)
  lastCalculated      DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([providerId])
  @@index([qualityScore])
}

/// Auto-computed customer trust scores (Engine 12)
model CustomerTrustScore {
  id                    String   @id @default(cuid())
  customerId            String
  trustScore            Float    @default(1.0) // 0.0 - 2.0
  totalJobsPosted       Int      @default(0)
  completedJobs         Int      @default(0)
  cancelledJobs         Int      @default(0)
  falseDisputes         Int      @default(0)
  chargebacks           Int      @default(0)
  avgProviderRating     Float    @default(0)
  positiveReviews       Int      @default(0)
  lastCalculated        DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@unique([customerId])
  @@index([trustScore])
}

/// Aggregated provider performance stats per category (Engine 11/14)
model ProviderPerformance {
  id                  String   @id @default(cuid())
  providerId          String
  providerType        String
  categoryId          String
  totalJobs           Int      @default(0)
  completedJobs       Int      @default(0)
  avgRating           Float    @default(0)
  avgDuration         Float    @default(0)
  totalEarnings       Float    @default(0)
  avgEarnings         Float    @default(0)
  disputeRate         Float    @default(0)
  responseTimeHours   Float    @default(0)
  acceptanceRate      Float    @default(0)
  lastJobAt           DateTime?
  lastCalculated      DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([providerId, categoryId])
  @@index([categoryId])
}

/// BI dashboard aggregated data (Engine 14)
model PlatformAnalytics {
  id              String   @id @default(cuid())
  metricKey       String   @unique           // e.g. "revenue_2025_01", "churn_category_cleaning"
  metricValue     Float    @default(0)
  metadata        String?                    // JSON string for extra data
  calculatedAt    DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([metricKey])
}

/// Versioned AI model snapshots (Engine 15)
model LearningModelVersion {
  id             String   @id @default(cuid())
  engineType     String                       // pricing, demand, search, quality, trust, matching
  version        Int      @default(1)
  accuracy       Float?                       // accuracy score 0-1
  sampleSize     Int      @default(0)
  config         String?                      // JSON config snapshot
  status         String   @default("active")  // active, deprecated, archived
  trainedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([engineType, status])
}

/// Category-level demand signals (Engine 8)
model CategoryDemand {
  id              String   @id @default(cuid())
  categoryId      String
  countryCode     String
  cityId          String?
  period          String                       // "2025-01", "2025-W02"
  avgJobsPerDay   Float    @default(0)
  avgSearchesPerDay Float  @default(0)
  avgProvidersOnline Float @default(0)
  demandLevel     String   @default("normal")  // low, normal, high, surge
  seasonalFactor  Float    @default(1.0)
  calculatedAt    DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([categoryId, countryCode, cityId, period])
}

/// Provider job acceptance log for learning (Engine 10)
model ProviderJobResponse {
  id           String   @id @default(cuid())
  providerId   String
  jobId        String
  respondedAt  DateTime?
  acceptedAt   DateTime?
  declinedAt   DateTime?
  declinedReason String?
  completedAt  DateTime?
  wasOnTime    Boolean?
  responseTimeMinutes Int?
  createdAt    DateTime @default(now())

  @@index([providerId])
  @@index([jobId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  role      String
  location  String?
  createdAt DateTime @default(now())

  @@unique([email])
  @@unique([phone])
  @@index([role])
  @@index([createdAt])
}

// ============================================
// PHASE 1: COMMISSION & SETTLEMENT MODELS
// ============================================

/// Weekly commission settlement for providers
model WeeklySettlement {
  id              String    @id @default(cuid())
  providerId      String    // userId of the provider
  providerType    String    // TASKER, COMPANY
  weekStart       DateTime  // Monday of the week
  weekEnd         DateTime  // Sunday of the week
  totalEarnings   Float     @default(0) // Total earned this week
  commissionRate  Float     @default(10.0) // Commission percentage
  commissionOwed  Float     @default(0) // totalEarnings * commissionRate / 100
  commissionPaid  Boolean   @default(false)
  paidAt          DateTime?
  dueAt           DateTime  // 7 days after weekEnd (next Monday)
  status          String    @default("PENDING") // PENDING, PAID, OVERDUE, SUSPENDED
  suspendedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  commissionPayments CommissionPayment[]

  @@unique([providerId, weekStart])
  @@index([providerId])
  @@index([status])
  @@index([weekStart])
  @@index([dueAt])
}

/// Phase 3: Cash-to-agent commission payment
model CommissionPayment {
  id                String    @id @default(cuid())
  providerId        String
  weeklySettlementId String
  weeklySettlement  WeeklySettlement @relation(fields: [weeklySettlementId], references: [id])
  referenceNumber   String    @unique // REF-XXXXX auto-generated
  amountDue         Float
  method            String    @default("CASH") // CASH, BANK
  status            String    @default("PENDING") // PENDING, CONFIRMED
  confirmedById     String?   // AdminUser id (FINANCE or SUPER_ADMIN)
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([providerId])
  @@index([referenceNumber])
  @@index([weeklySettlementId])
  @@index([status])
}

/// Off-platform deal reports (cheating)
model OffPlatformDeal {
  id              String   @id @default(cuid())
  reporterId      String   // userId of reporter
  againstUserId   String   // userId of person being reported
  againstUserType String   // TASKER, CUSTOMER, COMPANY
  jobId           String?  // Related job if any
  evidence        String   // Description of evidence
  evidenceUrls    String?  // JSON array of evidence photo URLs
  status          String   @default("PENDING") // PENDING, CONFIRMED, DISMISSED
  action          String?  // BAN, WARNING, NO_ACTION
  actionNote      String?  // Admin note on action taken
  reviewedBy      String?  // Admin ID who reviewed
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reporterId])
  @@index([againstUserId])
  @@index([status])
  @@index([createdAt])
}

/// Website feature requests / wishlist
model WishlistItem {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   @default("GENERAL") // GENERAL, APP, WEBSITE, ADMIN, API
  status      String   @default("NEW") // NEW, PLANNED, IN_PROGRESS, COMPLETED, REJECTED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  assignedTo  String?  // Admin user ID
  notes       String?  // Internal admin notes
  requestedBy String?  // User who requested (email or userId)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}
