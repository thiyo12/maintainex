  @@unique([customerId])
  @@index([trustScore])
}

/// Aggregated provider performance stats per category (Engine 11/14)
model ProviderPerformance {
  id                String    @id @default(cuid())
  providerId        String
  providerType      String
  categoryId        String
  totalJobs         Int       @default(0)
  completedJobs     Int       @default(0)
