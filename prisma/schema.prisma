generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  mxId              String?   @unique // MXU-XXXXX unique user ID
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  phoneVerified     Boolean   @default(false)
  role              String    @default("CUSTOMER")
  countryCode       String    @default("LK")
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  isSuspended       Boolean   @default(false)
  isBanned          Boolean   @default(false) // Banned for off-platform deals
  banReason         String?
  suspendedUntil    DateTime?
  suspensionReason  String?
  pushToken         String?
  nickname          String?
  lastNameChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions           UserSession[]
  otps               OTP[]
  loginActivities    LoginActivity[]
  bookings           Booking[]
  reviews            Review[]
  customerProfile    CustomerProfile?
  taskerProfile      TaskerProfile?
  jobPostings        JobPosting[]
  taskerReviewsGiven TaskerReview[]
  notifications      Notification[]
  conversations      ConversationParticipant[]
  messagesSent       Message[]
  disputes           Dispute[]
  companyProfile     CompanyProfile?
  teamMembers        TeamMember[]
  payouts            Payout[]
  identityDocs       IdentityDocument[]
  identityStatus     String                    @default("NOT_SUBMITTED")
  userDevices        UserDevice[]
  fraudEvents        FraudEvent[]
  adminFlags         AdminFlag[]
  offerBookings      OfferBooking[]
  payoutRequests     PayoutRequest[]
  customJobRequests  CustomJobRequest[]
  verificationPins   JobVerificationPin[]
  workerAssignments  CompanyJobAssignment[]

  @@index([countryCode])
}

model Admin {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String?
  role            String   @default("ADMIN")
  province        String?
  region          String   @default("LK")
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  canEditServices Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress        String
  userAgent        String
  isValid          Boolean   @default(true)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  refreshTokenHash String?
  tokenFamilyId    String?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@map("Session")
}

model OTP {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   String
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  metadata  Json?

  @@index([userId])
}

model LoginActivity {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  ipAddress    String
  userAgent    String
  location     String?
  isNewIP      Boolean  @default(false)
  isNewDevice  Boolean  @default(false)
  isSuspicious Boolean  @default(false)
  reason       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([isSuspicious])
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  icon         String?
  image        String?
  coverImage   String?
  countryCode  String   @default("LK")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  services Service[]
}

model Industry {
  id           String   @id @default(cuid())
  name         String
  icon         String?
  image        String?
  displayOrder Int      @default(0)
  isPartner    Boolean  @default(false)
  partnerName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String?
  description      String
  shortDescription String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  price            Float
  duration         Int
  features         String
  image            String?
  countryCode      String   @default("LK")
  displayOrder     Int      @default(0)
  views            Int      @default(0)
  isTrending       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  bookings Booking[]
  reviews  Review[]

  @@index([categoryId])
  @@index([views])
  @@index([isTrending])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  phone     String?
  location  String?
  districts String?
  province  String?
  region    String   @default("LK")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  bookings     Booking[]
  admins       Admin[]
  applications Application[]
  staff        Staff[]
  vacancies    JobVacancy[]
  invoices     Invoice[]
  quotations   Quotation[]

  @@index([city])
}

model Booking {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id])
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  date          DateTime
  timeSlot      String
  status        String         @default("PENDING")
  notes         String?
  totalPrice    Float
  budgetMin     Float?
  budgetMax     Float?
  name          String?
  phone         String?
  email         String?
  district      String?
  province      String?
  region        String         @default("LK")
  address       String?
  time          String?
  taskerId      String?
  tasker        TaskerProfile? @relation(fields: [taskerId], references: [id], onDelete: SetNull)
  templateJobId String?
  templateJob   TemplateJob?   @relation(fields: [templateJobId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([branchId])
  @@index([taskerId])
  @@index([templateJobId])
  @@index([status])
  @@index([date])
}

model Application {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  service    String
  experience String
  resumeUrl  String?
  cvUrl      String?
  status     String   @default("PENDING")
  notes      String?
  district   String?
  province   String?
  address    String?
  position   String?
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([branchId])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  status       String   @default("PENDING")
  customerName String?
  createdAt    DateTime @default(now())

  @@index([serviceId])
}

model Settings {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  type        String    @default("string") // number, boolean, string, json
  label       String    @default("")
  description String    @default("")
  groupName   String    @default("general")
  updatedBy   String?
  updatedAt   DateTime?
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string") // number, boolean, string, json
  label       String   @default("")
  description String   @default("")
  groupName   String   @default("general")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([groupName])
}

model JobMatchQueue {
  id          String         @id @default(cuid())
  jobId       String
  job         MarketplaceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskerId    String
  tasker      TaskerProfile  @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  score       Float
  rank        Int
  wave        Int?
  status      String         @default("pending") // pending, notified, accepted, declined, expired
  notifiedAt  DateTime?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())

  @@unique([jobId, taskerId])
  @@index([jobId, status])
  @@index([jobId, wave, status])
  @@index([taskerId])
}

model OfferMatchQueue {
  id          String        @id @default(cuid())
  bookingId   String
  booking     OfferBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  taskerId    String
  tasker      TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  score       Float
  rank        Int
  status      String        @default("pending") // pending, notified, accepted, declined, expired
  notifiedAt  DateTime?
  expiresAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([bookingId, taskerId])
  @@index([bookingId, status])
  @@index([expiresAt, status])
  @@index([taskerId])
}

model TaskerBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  label     String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model FraudEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminFlag {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("pending") // pending, reviewed, resolved, dismissed
  resolvedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, status])
  @@index([userId])
  @@index([status])
}

model UserDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  platform   String // ios, android
  pushToken  String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([userId])
  @@index([userId, userAgent])
}

model OfferTemplate {
  id                String   @id @default(cuid())
  categoryId        String
  title             String
  description       String
  priceLkr          Int
  scopeNotes        String?
  isRemote          Boolean  @default(false)
  availabilityLabel String   @default("Today")
  isFeatured        Boolean  @default(false)
  isActive          Boolean  @default(true)
  photoUrl          String?
  enrolledCount     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments OfferEnrollment[]
  bookings    OfferBooking[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model OfferEnrollment {
  id         String        @id @default(cuid())
  templateId String
  template   OfferTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  taskerId   String
  tasker     TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  status     String        @default("active") // active, paused, withdrawn
  enrolledAt DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([templateId, taskerId])
  @@index([templateId])
  @@index([taskerId])
}

model OfferBooking {
  id              String        @id @default(cuid())
  templateId      String
  template        OfferTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taskerId        String?
  currentTaskerId String?
  scheduledAt     DateTime
  latitude        Float?
  longitude       Float?
  status          String        @default("pending") // pending, finding, accepted, in_progress, completed, no_tasker_available, cancelled
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  matchQueue OfferMatchQueue[]

  @@index([templateId])
  @@index([customerId])
  @@index([taskerId])
  @@index([status])
}

model PayoutRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  currency    String    @default("LKR")
  method      String    @default("bank") // bank, wallet
  status      String    @default("pending") // pending, processing, completed, failed
  notes       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model ActivityLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  adminName   String?
  branchId    String?
  action      String
  entityType  String
  entityId    String?
  description String
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// CRM MODELS - Customer Relationship Management
// ============================================

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Customer Classification
  customerType String @default("REGULAR") // REGULAR, VIP, CORPORATE, POTENTIAL
  status       String @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED

  // Profile details
  profileImage     String?
  birthday         DateTime?
  gender           String?
  language         String?
  emergencyContact String?

  // Preferences
  preferredContact String? // EMAIL, PHONE, WHATSAPP
  smsOptIn         Boolean @default(true)
  emailOptIn       Boolean @default(true)
  whatsappOptIn    Boolean @default(true)

  // Source tracking
  source        String? // WEBSITE, REFERRAL, CAMPAIGN, WALK_IN
  sourceDetails String?

  // Lifetime value
  totalBookings Int   @default(0)
  totalSpent    Float @default(0)
  lifetimeValue Float @default(0)

  // First & last interactions
  firstBooking DateTime?
  lastBooking  DateTime?

  // Notes & blacklist
  summary         String? // Short summary/notes about customer
  blacklistReason String?
  blacklistDate   DateTime?

  // Province (for query performance and province-based access)
  province String?

  // Metadata
  metadata String? // JSON for additional data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tags           CustomerTag[]
  addresses      CustomerAddress[]
  activities     CustomerActivity[]
  notes          CustomerNote[]
  communications CustomerCommunication[]
  segments       CustomerSegmentCustomer[]

  @@index([userId])
  @@index([customerType])
  @@index([status])
  @@index([province])
  @@index([createdAt])
}

model CustomerTag {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  color       String  @default("#6366f1") // Hex color for UI
  description String?

  // Tag type
  type String @default("GENERAL") // GENERAL, BEHAVIOR, VALUE, PREFERENCE

  // Usage stats
  usageCount Int @default(0)

  isSystem Boolean @default(false) // System tags can't be deleted
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers CustomerProfile[]

  @@index([name])
  @@index([type])
}

model CustomerSegment {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  // Segment criteria (JSON)
  criteria String // {"province": "Western", "minBookings": 3}

  // Segment type
  type String @default("DYNAMIC") // DYNAMIC, STATIC

  // Stats
  memberCount Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers CustomerSegmentCustomer[]

  @@index([name])
  @@index([type])
}

model CustomerSegmentCustomer {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())
  addedBy String? // Admin ID who added

  @@unique([customerId, segmentId])
  @@index([customerId])
  @@index([segmentId])
}

model CustomerAddress {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label        String // Home, Office, Other
  address      String
  district     String
  province     String
  postalCode   String?
  instructions String? // Delivery/access instructions

  // Contact person at address
  contactName  String?
  contactPhone String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CustomerNote {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  content String
  type    String @default("GENERAL") // GENERAL, COMPLAINT, FEEDBACK, INTERNAL

  // Author tracking
  createdById   String?
  createdByName String?

  isPrivate Boolean @default(false) // Private notes only visible to creator

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdById])
}

model CustomerActivity {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type String // BOOKING_CREATED, BOOKING_COMPLETED, CALL_MADE, CALL_RECEIVED, 
  // EMAIL_SENT, EMAIL_OPENED, WHATSAPP_SENT, WHATSAPP_RECEIVED,
  // NOTE_ADDED, TAG_ADDED, TAG_REMOVED, SEGMENT_ADDED, SEGMENT_REMOVED,
  // STATUS_CHANGED, PROFILE_UPDATED, ADDRESS_ADDED, LOGIN

  // Activity details
  title       String
  description String?
  metadata    String? // JSON for additional data

  // Related entities
  relatedId   String? // Booking ID, etc.
  relatedType String? // BOOKING, SERVICE, etc.

  // Author tracking
  createdById    String?
  createdByName  String?
  createdByEmail String?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model CustomerCommunication {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Communication details
  channel   String // EMAIL, SMS, WHATSAPP, NOTIFICATION, CALL
  direction String // OUTBOUND, INBOUND

  subject String?
  content String

  // Status tracking
  status        String  @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED, CANCELLED
  statusDetails String?

  // External reference
  externalId     String? // Third-party message ID (WhatsApp message ID, etc.)
  externalStatus String? // Status from WhatsApp API, etc.

  // Sending details
  sentById    String?
  sentByEmail String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  // Template reference
  templateId   String?
  templateName String?

  // Metadata
  metadata String? // JSON for additional data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([channel])
  @@index([direction])
  @@index([status])
  @@index([sentById])
  @@index([createdAt])
}

// ============================================
// SECURITY MODELS
// ============================================

model SecurityAudit {
  id String @id @default(cuid())

  // Action details
  action   String // LOGIN, LOGOUT, VIEW, CREATE, UPDATE, DELETE, EXPORT, API_CALL
  category String // AUTH, CUSTOMER, BOOKING, SERVICE, REPORT, ADMIN, SYSTEM

  // Who
  userId       String?
  userEmail    String?
  userRole     String?
  userProvince String?

  // What
  entityType String?
  entityId   String?
  entityName String?

  // Details
  description String  @default("")
  details     String? // JSON of additional context
  oldValue    String? // JSON of previous state
  newValue    String? // JSON of new state

  // Context
  ipAddress String?
  userAgent String?
  sessionId String?

  // Result
  success      Boolean @default(true)
  errorMessage String?

  // Risk assessment
  riskLevel    String  @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  isSuspicious Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([category])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([ipAddress])
  @@index([isSuspicious])
  @@index([createdAt])
  @@index([riskLevel])
}

model ApiKey {
  id   String @id @default(cuid())
  name String
  key  String @unique // Hashed version

  // Key metadata (unhashed prefix stored for identification)
  prefix  String // First 8 chars of key for identification
  version Int    @default(1)

  // Permissions
  permissions String // READ, WRITE, DELETE, ADMIN

  // Scoping
  scope    String  @default("FULL") // FULL, CUSTOMERS, BOOKINGS, REPORTS
  province String? // If set, key only works for this province

  // Status
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  lastIp     String?

  // Usage limits
  rateLimit    Int @default(100) // Requests per minute
  requestCount Int @default(0)

  // Owner
  createdById    String
  createdByEmail String
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([createdById])
  @@index([isActive])
}

model RateLimitLog {
  id String @id @default(cuid())

  // What was rate limited
  identifier String // IP address, API key, or user ID
  type       String // IP, API_KEY, USER, login, api, upload, password-reset, login-failed

  // Endpoint
  endpoint String @default("")
  method   String @default("")

  // Request details
  requestCount Int @default(1)

  // Window
  windowStart DateTime @default(now())
  windowEnd   DateTime @default(now())

  // Result
  limited    Boolean   @default(false)
  blockUntil DateTime?

  createdAt DateTime @default(now())

  @@index([identifier, windowStart])
  @@index([identifier, type, createdAt])
  @@index([limited])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model IpBlock {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ip])
  @@index([expiresAt])
}

model FailedLogin {
  id String @id @default(cuid())

  // Who tried to login
  email     String
  ipAddress String
  userAgent String?

  // Attempt details
  attemptCount Int       @default(1)
  blocked      Boolean   @default(false)
  blockUntil   DateTime?

  // Why it failed
  reason String? // INVALID_PASSWORD, INVALID_OTP, ACCOUNT_LOCKED, etc.

  // Location
  location String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, ipAddress])
  @@index([blocked])
  @@index([createdAt])
}

model DataExport {
  id String @id @default(cuid())

  // Export details
  type   String // CUSTOMERS, BOOKINGS, REPORTS, FULL
  format String @default("CSV") // CSV, JSON, EXCEL

  // Filters applied
  filters String? // JSON of filters used

  // File info
  fileName String?
  fileSize Int?
  filePath String?

  // Status
  status   String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress Int    @default(0)

  // Requester
  requestedById    String
  requestedByEmail String

  // Download
  downloadUrl String?
  expiresAt   DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
}

// Job Vacancies for Careers page
model JobVacancy {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  isActive    Boolean  @default(true)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([branchId])
}

// Staff managed by branch admins
model Staff {
  id        String   @id @default(cuid())
  staffId   String   @unique // Auto-generated: EMP-001, EMP-002...
  name      String
  phone     String?
  email     String?
  position  String?
  photo     String?
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([staffId])
}

model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique
  type            String    @default("INVOICE")
  branchId        String
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  subtotal        Float
  tax             Float     @default(0)
  total           Float
  status          String    @default("DRAFT")
  paymentStatus   String    @default("UNPAID")
  amountPaid      Float     @default(0)
  dueDate         DateTime?
  notes           String?
  createdBy       String
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  branch Branch        @relation(fields: [branchId], references: [id])
  items  InvoiceItem[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  totalPrice  Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique
  type            String   @default("QUOTATION")
  branchId        String
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  validUntil      DateTime
  status          String   @default("DRAFT")
  notes           String?
  createdBy       String
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch          @relation(fields: [branchId], references: [id])
  items  QuotationItem[]
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  totalPrice  Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ============================================
// JOB SECTION — CATEGORIES & TEMPLATE JOBS
// ============================================

model JobCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String?  @unique
  iconName  String
  colorHex  String
  sortOrder Int      @default(0)
  countries String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  jobs             TemplateJob[]
  serviceTemplates ServiceTemplate[]

  @@index([sortOrder])
  @@index([isActive])
}

model TemplateJob {
  id                     String      @id @default(cuid())
  categoryId             String
  category               JobCategory @relation(fields: [categoryId], references: [id])
  name                   String
  description            String
  whatIsIncluded         String
  typicalDurationMinutes Int
  priceMin               Float
  priceMax               Float
  currency               String      @default("LKR")
  isPopular              Boolean     @default(false)
  isCompanyOnly          Boolean     @default(false)
  countries              String
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())

  taskerSkills      TaskerSkill[]
  bookings          Booking[]
  seasonalOfferJobs SeasonalOfferJob[]
  serviceTemplates  ServiceTemplate[]

  @@index([categoryId])
  @@index([isPopular])
  @@index([isActive])
}

// Smart booking service template: holds the smart question set + pricing hint
// used by the 5-step booking wizard. A template belongs to a JobCategory and may
// optionally be linked to a specific TemplateJob (sub-service).
model ServiceTemplate {
  id                     String       @id @default(cuid())
  jobCategoryId          String
  jobCategory            JobCategory  @relation(fields: [jobCategoryId], references: [id], onDelete: Cascade)
  templateJobId          String?
  templateJob            TemplateJob? @relation(fields: [templateJobId], references: [id], onDelete: SetNull)
  name                   String
  slug                   String       @unique
  description            String
  questionsJson          String // JSON-encoded smart question set
  defaultDurationMinutes Int          @default(60)
  priceMin               Float        @default(0)
  priceMax               Float        @default(0)
  currency               String       @default("LKR")
  countryCode            String       @default("LK")
  isActive               Boolean      @default(true)
  sortOrder              Int          @default(0)
  // Phase 10.3 — Pricing intelligence
  pricingMode            String       @default("SMART_QUOTE") // INSTANT_PRICE, SMART_QUOTE, INSPECTION_FIRST
  benchmarkEligible      Boolean      @default(true)
  instantPriceCents      BigInt?      // Fixed price in minor units (only for INSTANT_PRICE)
  inspectionFeeCents     BigInt?      // Inspection/call-out fee in minor units (only for INSPECTION_FIRST)
  createdAt              DateTime     @default(now())

  @@index([jobCategoryId])
  @@index([templateJobId])
  @@index([slug])
  @@index([isActive])
}

// Customer submitted jobs that are not yet listed in the app.
// Admin reviews these; if enough customers request the same job it can be
// added as a TemplateJob/ServiceTemplate so taskers can then handle it.
model CustomJobRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String
  categoryId     String?
  cityName       String?
  budgetMin      Float?
  budgetMax      Float?
  status         String   @default("PENDING") // PENDING | APPROVED | DECLINED | CONVERTED
  adminNote      String? // admin feedback
  convertedJobId String? // TemplateJob id if admin converted it into a listing
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model TaskerSkill {
  id              String        @id @default(cuid())
  taskerId        String
  tasker          TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  jobId           String
  job             TemplateJob   @relation(fields: [jobId], references: [id])
  experienceYears Int           @default(0)
  experienceLevel Int           @default(1) // 1 = Beginner, 2 = Intermediate, 3 = Expert
  hourlyRate      Float         @default(0)
  fixedRate       Float         @default(0)
  currency        String        @default("LKR")
  countryCode     String        @default("LK")

  @@unique([taskerId, jobId])
  @@index([taskerId])
  @@index([jobId])
}

model CompanySpecialty {
  id           String         @id @default(cuid())
  companyId    String
  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId   String?
  jobId        String?
  professionId String?
  profession   Profession?    @relation(fields: [professionId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([categoryId])
  @@index([jobId])
  @@index([professionId])
}

// ============================================
// PROFESSION & SKILL TAXONOMY
// ============================================

model Profession {
  id          String   @id @default(cuid())
  slug        String   @unique
  i18nKey     String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills                   ProfessionSkill[]
  taskerProfessions        TaskerProfession[]
  companyProfessions       CompanyProfession[]
  serviceRequirements      ServiceProfessionRequirement[]
  jurisdictionRequirements ProfessionJurisdictionRequirement[]
  companySpecialties       CompanySpecialty[]
}

model ProfessionSkill {
  id           String   @id @default(cuid())
  professionId String
  slug         String
  i18nKey      String
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profession               Profession                          @relation(fields: [professionId], references: [id], onDelete: Restrict)
  taskerSkills             TaskerProfessionSkill[]
  companySkills            CompanyProfessionSkill[]
  serviceSkillRequirements ServiceSkillRequirement[]
  jurisdictionRequirements ProfessionJurisdictionRequirement[]

  @@unique([professionId, slug])
  @@index([professionId])
}

model TaskerProfession {
  id              String    @id @default(cuid())
  taskerProfileId String
  professionId    String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taskerProfile TaskerProfile           @relation(fields: [taskerProfileId], references: [id], onDelete: Cascade)
  profession    Profession              @relation(fields: [professionId], references: [id], onDelete: Restrict)
  skills        TaskerProfessionSkill[]

  @@unique([taskerProfileId, professionId])
  @@index([taskerProfileId])
  @@index([professionId])
  @@index([status])
}

model TaskerProfessionSkill {
  id                 String   @id @default(cuid())
  taskerProfessionId String
  professionSkillId  String
  createdAt          DateTime @default(now())

  taskerProfession TaskerProfession @relation(fields: [taskerProfessionId], references: [id], onDelete: Cascade)
  professionSkill  ProfessionSkill  @relation(fields: [professionSkillId], references: [id], onDelete: Restrict)

  @@unique([taskerProfessionId, professionSkillId])
  @@index([taskerProfessionId])
  @@index([professionSkillId])
}

model CompanyProfession {
  id               String    @id @default(cuid())
  companyProfileId String
  professionId     String
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  approvedAt       DateTime?
  approvedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyProfile CompanyProfile           @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  profession     Profession               @relation(fields: [professionId], references: [id], onDelete: Restrict)
  skills         CompanyProfessionSkill[]

  @@unique([companyProfileId, professionId])
  @@index([companyProfileId])
  @@index([professionId])
  @@index([status])
}

model CompanyProfessionSkill {
  id                  String   @id @default(cuid())
  companyProfessionId String
  professionSkillId   String
  createdAt           DateTime @default(now())

  companyProfession CompanyProfession @relation(fields: [companyProfessionId], references: [id], onDelete: Cascade)
  professionSkill   ProfessionSkill   @relation(fields: [professionSkillId], references: [id], onDelete: Restrict)

  @@unique([companyProfessionId, professionSkillId])
  @@index([companyProfessionId])
  @@index([professionSkillId])
}

model ServiceProfessionRequirement {
  id                 String   @id @default(cuid())
  serviceTemplateId  String
  professionId       String
  alternativeGroupId String?
  createdAt          DateTime @default(now())

  profession        Profession                @relation(fields: [professionId], references: [id], onDelete: Restrict)
  skillRequirements ServiceSkillRequirement[]

  @@unique([serviceTemplateId, professionId])
  @@index([serviceTemplateId])
  @@index([professionId])
  @@index([alternativeGroupId])
}

model ServiceSkillRequirement {
  id                     String   @id @default(cuid())
  serviceProfessionReqId String
  professionSkillId      String
  requirementMode        String   @default("REQUIRED_ALL") // REQUIRED_ALL, REQUIRED_ANY_OF, PREFERRED
  createdAt              DateTime @default(now())

  serviceProfessionRequirement ServiceProfessionRequirement @relation(fields: [serviceProfessionReqId], references: [id], onDelete: Cascade)
  professionSkill              ProfessionSkill              @relation(fields: [professionSkillId], references: [id], onDelete: Restrict)

  @@unique([serviceProfessionReqId, professionSkillId])
  @@index([serviceProfessionReqId])
  @@index([professionSkillId])
  @@index([requirementMode])
}

model ProfessionSubmission {
  id                    String    @id @default(cuid())
  submittedById         String
  requestedName         String
  description           String?
  suggestedServices     String?
  status                String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, DUPLICATE
  canonicalProfessionId String?
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([submittedById])
}

model ProfessionJurisdictionRequirement {
  id                 String    @id @default(cuid())
  countryCode        String
  province           String?
  professionId       String
  skillId            String?
  credentialRequired Boolean   @default(false)
  credentialType     String?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profession Profession       @relation(fields: [professionId], references: [id], onDelete: Restrict)
  skill      ProfessionSkill? @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([countryCode, province, professionId, skillId])
  @@index([countryCode])
  @@index([professionId])
}

// ============================================
// PROVIDER OPPORTUNITY (Phase 10.2)
// ============================================

model ProviderOpportunity {
  id              String    @id @default(cuid())
  jobId           String
  taskerId        String?
  companyId       String?
  providerType    String    // INDIVIDUAL, COMPANY
  waveNumber      Int       @default(1)
  status          String    @default("PENDING") // PENDING, SENT, VIEWED, ACCEPTED, DECLINED, EXPIRED, WITHDRAWN, CANCELLED
  sentAt          DateTime?
  expiresAt       DateTime?
  respondedAt     DateTime?
  response        String?   // ACCEPTED, DECLINED
  rankAtSend      Int?
  scoreSnapshot   Float?
  eligibilitySnapshot String? // JSON: eligibility gates that passed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([jobId, taskerId])
  @@unique([jobId, companyId])
  @@index([jobId])
  @@index([taskerId, sentAt])
  @@index([companyId, sentAt])
  @@index([status])
  @@index([waveNumber])
}

// ============================================
// PHASE 10.3 — PRICING INTELLIGENCE
// ============================================

model PriceBenchmark {
  id                    String   @id @default(cuid())
  serviceTemplateId     String
  countryCode           String
  region                String?  // Province/state (e.g. "Northern Province", "Ontario")
  city                  String?  // City/district (e.g. "Jaffna", "Toronto")
  currency              String   // ISO 4217
  pricingMode           String   // INSTANT_PRICE, SMART_QUOTE, INSPECTION_FIRST

  // Statistical data
  sampleSize            Int      @default(0)
  medianAmountCents     BigInt   @default(0)
  lowerPercentileCents  BigInt   @default(0) // P25
  upperPercentileCents  BigInt   @default(0) // P75
  minimumObservedCents  BigInt?
  maximumObservedCents  BigInt?

  // Source & provenance
  sourceType            String   // MAINTAINEX_COMPLETED_JOBS, MANUAL_MARKET_RESEARCH, PUBLIC_PROVIDER_PRICE, PARTNER_DATA, ADMIN_ESTIMATE, OTHER
  sourceReference       String?  // Research batch ID, dataset reference, admin note
  methodologyNote       String?  // How the benchmark was calculated

  // Geography level (derived at creation: CITY > PROVINCE > COUNTRY)
  geographyLevel        String   @default("COUNTRY") // CITY, PROVINCE, COUNTRY

  // Lifecycle
  status                String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PUBLISHED, SUPERSEDED
  version               Int      @default(1)
  effectiveFrom         DateTime?
  effectiveTo           DateTime? // null = currently active
  createdBy             String?
  submittedBy           String?
  submittedAt           DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  publishedAt           DateTime?
  supersededBy          String?  // ID of the version that replaced this one
  supersededFromId      String?  // ID of the benchmark this one superseded

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([serviceTemplateId, countryCode, region, city, version])
  @@index([serviceTemplateId])
  @@index([countryCode, region, city])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@index([currency])
}

model QuoteLineItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         JobQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type          String   // LABOUR, MATERIALS, CALL_OUT, DIAGNOSIS, TRAVEL, EQUIPMENT, PERMIT, OTHER, TAX, PLATFORM_SERVICE_CHARGE
  description   String
  quantity      Float    @default(1)
  unit          String?  // hour, item, km, etc.
  unitAmountCents BigInt  // Price per unit in minor units
  totalAmountCents BigInt // quantity * unitAmountCents (server-validated)
  currency      String   // ISO 4217, must match quote currency
  sortOrder     Int      @default(0)
  metadata      String?  // JSON for extra data
  createdAt     DateTime @default(now())

  @@index([quoteId])
  @@index([type])
}

// ============================================
// MOBILE MARKETPLACE MODELS
// ============================================

model TaskerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mxId               String?   @unique // MXT-XXXXX unique tasker ID
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNote   String? // Admin rejection reason
  verifiedBy         String? // Admin ID who verified
  verifiedAt         DateTime?

  bio               String?
  dateOfBirth       DateTime?
  address           String?
  experienceSummary String?
  hourlyRate        Float   @default(0)
  skills        String? // Category slugs
  serviceAreas  String? // District names
  countryCode   String  @default("LK")
  rating        Float   @default(0)
  completedJobs Int     @default(0)
  isVerified    Boolean @default(false)
  isOnline      Boolean @default(false)
  profileImage  String?

  // Experience proof
  experienceProofUrl String? // Certificate or portfolio URL
  hasDrivingLicense  Boolean @default(false)
  drivingLicenseUrl  String?

  // Reputation & scoring
  compositeScore Int       @default(50)
  penaltyPoints  Int       @default(0)
  completionRate Int       @default(100)
  avgResponseMin Int       @default(60)
  scoreUpdatedAt DateTime?

  // Location
  latitude          Float?
  longitude         Float?
  serviceRadius     Float?
  locationUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids              Bid[]
  assignments       Assignment[]
  reviews           TaskerReview[]
  taskerSkills      TaskerSkill[]
  taskerProfessions TaskerProfession[]
  bookings          Booking[]
  matchQueue        JobMatchQueue[]
  offerMatchQueue   OfferMatchQueue[]
  enrollments       OfferEnrollment[]

  @@index([isOnline])
  @@index([isVerified])
  @@index([rating])
  @@index([compositeScore])
  @@index([countryCode])
}

model JobPosting {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title         String
  description   String
  category      String // Category slug
  budget        Float
  location      String // District or address
  latitude      Float?
  longitude     Float?
  isRemote      Boolean   @default(false)
  scheduledDate DateTime?
  status        String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids        Bid[]
  assignments Assignment[]
  disputes    Dispute[]

  @@index([customerId])
  @@index([status])
  @@index([category])
  @@index([location])
  @@index([createdAt])
}

model Bid {
  id       String        @id @default(cuid())
  jobId    String
  job      JobPosting    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskerId String
  tasker   TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  amount  Float
  message String?
  status  String  @default("PENDING") // PENDING, ACCEPTED, REJECTED

  createdAt DateTime @default(now())

  @@unique([jobId, taskerId])
  @@index([jobId])
  @@index([taskerId])
  @@index([status])
}

model Assignment {
  id       String        @id @default(cuid())
  jobId    String
  job      JobPosting    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskerId String
  tasker   TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  status      String    @default("ASSIGNED") // ASSIGNED, EN_ROUTE, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([taskerId])
  @@index([status])
}

model TaskerReview {
  id         String        @id @default(cuid())
  taskerId   String
  tasker     TaskerProfile @relation(fields: [taskerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation(fields: [reviewerId], references: [id])

  jobId   String?
  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([taskerId])
  @@index([reviewerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  data      String? // JSON payload
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ============================================
// MOBILE CHAT MODELS
// ============================================

model Conversation {
  id        String   @id @default(cuid())
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ============================================
// MOBILE DISPUTE MODELS
// ============================================

model Dispute {
  id          String     @id @default(cuid())
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User       @relation(fields: [raisedById], references: [id])
  reason      String
  description String
  resolution  String?
  status      String     @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  countryCode String     @default("LK")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([countryCode])
}

// ============================================
// COMPANY MODELS
// ============================================

model CompanyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mxId              String? @unique // MXC-XXXXX unique company ID
  companyName       String
  registrationNo    String?
  taxId             String? // Tax identification number
  description       String?
  services          String
  serviceAreas      String
  countryCode       String  @default("LK")
  rating            Float   @default(0)
  completedProjects Int     @default(0)
  isVerified        Boolean @default(false)
  logo              String?

  // Verification
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNote   String? // Admin rejection reason
  verifiedBy         String? // Admin ID who verified
  verifiedAt         DateTime?
  businessRegDocUrl  String? // Business registration document URL

  // Staff requirements
  minStaffCount Int     @default(3) // Minimum staff required
  staffCount    Int     @default(0) // Actual staff count
  staffProofUrl String? // Proof of staff (document URL)

  // Location
  latitude      Float?
  longitude     Float?
  serviceRadius Float?

  commissionRate        Float     @default(10.0) // Changed from 15 to 10
  subscriptionStatus    String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  subscriptionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts          Contract[]
  teamMembers        TeamMember[]
  specialties        CompanySpecialty[]
  companyProfessions CompanyProfession[]
  invites            TeamInvite[]
  subscriptions      CompanySubscription[]
  auditLogs          CompanyAuditLog[]
  jobAssignments     CompanyJobAssignment[]

  @@index([isVerified])
  @@index([rating])
  @@index([subscriptionStatus])
  @@index([countryCode])
}

model TeamMember {
  id        String         @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  name          String
  role          String // COMPANY_OWNER, MANAGER, DISPATCHER, WORKER, FINANCE
  status        String   @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED, REMOVED
  skills        String
  isOnline      Boolean  @default(false)
  rating        Float    @default(0)
  completedJobs Int      @default(0)
  invitedBy     String? // userId of who invited this member
  joinedAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model TeamInvite {
  id        String         @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email     String?
  phone     String?
  name      String
  role      String   @default("WORKER") // COMPANY_OWNER, MANAGER, DISPATCHER, WORKER, FINANCE
  token     String   @unique
  status    String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, CANCELLED
  invitedBy String? // userId of the inviter
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([token])
  @@index([status])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String?
  features    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions CompanySubscription[]
}

model CompanySubscription {
  id        String           @id @default(cuid())
  companyId String
  company   CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  status    String           @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  startDate DateTime         @default(now())
  endDate   DateTime?
  autoRenew Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([companyId])
  @@index([planId])
  @@index([status])
}

model Certification {
  id                 String    @id @default(cuid())
  holderType         String // INDIVIDUAL, COMPANY
  holderId           String // userId for INDIVIDUAL, companyProfile id for COMPANY
  certificationType  String // ELECTRICAL, PLUMBING, GAS, STRUCTURAL, GENERAL, etc.
  name               String // Display name of the certification
  issuer             String? // Issuing authority
  referenceNumber    String? // Certificate/license number
  issuedDate         DateTime?
  expiryDate         DateTime?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
  verificationNote   String?
  verifiedBy         String? // Admin userId who verified
  verifiedAt         DateTime?
  documentUrl        String? // Supporting document URL
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([holderType, holderId])
  @@index([verificationStatus])
  @@index([expiryDate])
}

model CompanyAuditLog {
  id          String         @id @default(cuid())
  companyId   String
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId     String // userId of the actor
  actorRole   String // Role of the actor at the time of action
  action      String // COMPANY_CREATE, OWNERSHIP_TRANSFER, MEMBER_INVITE, MEMBER_ACCEPT, MEMBER_REMOVE, ROLE_CHANGE, SUSPENSION, KYC_SUBMIT, KYC_APPROVE, KYC_REJECT, CERTIFICATION_ADD, CERTIFICATION_VERIFY
  targetType  String? // TeamMember, Certification, IdentityDocument, CompanyProfile
  targetId    String? // ID of the target entity
  description String? // Human-readable description
  metadata    String? // JSON string for additional data
  ipAddress   String?
  createdAt   DateTime       @default(now())

  @@index([companyId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model ProviderDocument {
  id                 String    @id @default(cuid())
  providerType       String // INDIVIDUAL, COMPANY
  providerId         String // userId for INDIVIDUAL, companyProfile id for COMPANY
  documentType       String // BUSINESS_REG, TAX_ID, STAFF_PROOF, EXPERIENCE_PROOF, DRIVING_LICENSE, INSURANCE, OTHER
  fileName           String
  fileUrl            String // Cloudinary or storage URL
  fileSize           Int? // bytes
  mimeType           String?
  verificationStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  verificationNote   String?
  verifiedBy         String?
  verifiedAt         DateTime?
  isPublic           Boolean   @default(false) // Should always be false for identity docs
  uploadedBy         String // userId who uploaded
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerType, providerId])
  @@index([verificationStatus])
}

model Contract {
  id          String         @id @default(cuid())
  companyId   String
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientName  String
  title       String
  description String?
  value       Float
  status      String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  progress    Int            @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  milestones Milestone[]

  @@index([companyId])
  @@index([status])
}

model Milestone {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  status      String    @default("PENDING") // PENDING, APPROVED, IN_REVIEW
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([contractId])
  @@index([status])
}

// ============================================
// EARNINGS & PAYOUT MODELS
// ============================================

model Payout {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         BigInt
  description    String?
  status         String    @default("PENDING") // PENDING, PROCESSING, CLEARED, REJECTED, FAILED
  source         String // JOB, CONTRACT, MILESTONE, WITHDRAWAL
  sourceId       String? // Job ID, Contract ID, etc.
  method         String? // bank, wallet
  bankDetails    String? // JSON: account holder / account number / branch / bank name / notes
  rejectedReason String? // set when status = REJECTED
  processedBy    String? // AdminUser email/id that processed this payout
  currency       String    @default("LKR")
  countryCode    String    @default("LK")
  createdAt      DateTime  @default(now())
  clearedAt      DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([countryCode])
}

// ============================================
// FLASH OFFERS — Landing page promotions
// ============================================

model FlashOffer {
  id            String  @id @default(cuid())
  title         String
  description   String?
  discountType  String // PERCENTAGE or FLAT
  discountValue Float
  couponCode    String?
  linkUrl       String?
  badgeText     String  @default("🔥 FLASH")
  bgColor       String  @default("#FFC300")
  textColor     String  @default("#1a1a1a")

  startsAt  DateTime
  expiresAt DateTime

  maxClaims     Int @default(50)
  currentClaims Int @default(0)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([expiresAt])
}

// ============================================
// SEASONAL OFFERS — Country + season-based promotions
// ============================================

model SeasonalOffer {
  id           String   @id @default(cuid())
  title        String
  description  String?
  slug         String   @unique
  season       String // "winter" | "spring" | "summer" | "fall" | "general"
  country      String // "LK" | "CA"
  image        String?
  badgeText    String?
  bgColor      String?
  textColor    String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs SeasonalOfferJob[]

  @@index([season, country])
  @@index([isActive])
}

model SeasonalOfferJob {
  id              String        @id @default(cuid())
  seasonalOfferId String
  seasonalOffer   SeasonalOffer @relation(fields: [seasonalOfferId], references: [id], onDelete: Cascade)
  templateJobId   String
  templateJob     TemplateJob   @relation(fields: [templateJobId], references: [id])
  price           Float?
  currency        String        @default("LKR")

  @@unique([seasonalOfferId, templateJobId])
  @@index([templateJobId])
}

// ============================================
// MARKETPLACE V2 — Job Marketplace System
// ADD-ONLY — Does not affect existing tables
// Scalar foreign keys only — no Prisma relations
// to avoid modifying User/JobCategory models
// ============================================

model Country {
  id   String @id @default(cuid())
  name String
  code String @unique

  states State[]

  @@index([code])
}

model State {
  id        String  @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  cities City[]

  @@index([countryId])
}

model City {
  id      String @id @default(cuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  areas Area[]

  @@index([stateId])
}

model Area {
  id     String @id @default(cuid())
  name   String
  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  @@index([cityId])
}

model MarketplaceJob {
  id                String    @id @default(cuid())
  customerId        String
  title             String
  description       String
  categoryId        String
  serviceTemplateId String?
  templateJobId     String?
  countryCode       String    @default("LK")
  targetTaskerId    String?
  photos            String
  budgetType        String // FIXED, HOURLY, NEGOTIABLE, REQUEST_QUOTES
  budgetAmount      BigInt?
  areaId            String?
  postalCode        String?
  preferredDate     DateTime?
  preferredTimeSlot String?
  addressStreet     String? // Only shared after escrow payment
  addressBuilding   String?
  addressApartment  String?
  addressLandmark   String?
  addressSharedAt   DateTime?
  latitude          Float?
  longitude         Float?
  urgency           String    @default("normal") // normal, urgent, emergency
  estimatedDuration Float? // Estimated hours
  workersCount      Int       @default(1)
  status            String    @default("OPEN") // OPEN, QUOTE_ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED
  responseDeadline  DateTime?
  responseState     String    @default("awaiting") // awaiting, responded, escalated, resolved
  escalatedAt       DateTime?
  isActive          Boolean   @default(true)
  aiEstimateJson    String? // JSON-encoded AI price estimate
  materialHandling  String? // tasker_brings, customer_provides, quote_both
  currentWave       Int       @default(0)
  waveSentAt        DateTime?
  notifiedCount     Int       @default(0) // Number of taskers notified (uber-style blast)
  smartBookingJson  String? // JSON-encoded smart booking answers / estimate / timeSlot / paymentMethod / locationText
  // Phase 10.4 — Inspection + Change Order lifecycle
  requiresInspection Boolean   @default(false)
  approvedQuoteId    String?
  approvedQuoteVersion Int?
  finalAuthorizedAmountCents BigInt?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  matchQueue        JobMatchQueue[]
  inspections       JobInspection[]
  changeOrders      JobChangeOrder[]
  evidenceRecords   JobEvidence[]
  riskEvents        MarketplaceRiskEvent[]
  verificationPins  JobVerificationPin[]
  assignments       CompanyJobAssignment[]
  lifecycleEvents   JobLifecycleEvent[]

  @@index([customerId])
  @@index([categoryId])
  @@index([areaId])
  @@index([status])
  @@index([createdAt])
  @@index([countryCode])
}

model JobQuote {
  id           String  @id @default(cuid())
  jobId        String
  providerId   String
  providerType String // INDIVIDUAL, COMPANY
  price        BigInt
  actorUserId  String? // UserId who submitted the quote (for company quotes, the acting member)
  actorRole    String? // Company role of actor at time of submission (COMPANY_OWNER, MANAGER, DISPATCHER)

  estimatedCompletionTime String
  message                 String?
  attachments             String
  status                  String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN, SUPERSEDED
  // Phase 10.3 — Quote intelligence
  currency                String   @default("LKR")
  subtotalCents           BigInt?  // Sum of line items before tax/fees
  taxCents                BigInt?  // Tax amount
  totalCents              BigInt?  // Server-calculated total (subtotal + tax)
  benchmarkClassification String?  // VERY_LOW, BELOW_TYPICAL, TYPICAL, ABOVE_TYPICAL, VERY_HIGH, INSUFFICIENT_DATA
  benchmarkId             String?  // Reference to PriceBenchmark used for classification
  revisionNumber          Int      @default(1)
  parentQuoteId           String?  // Previous revision's quote ID (for revision chain)
  revisionReason          String?  // Why revision was created
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  lineItems QuoteLineItem[]

  @@index([jobId])
  @@index([providerId])
  @@index([status])
  @@index([parentQuoteId])
}

model JobEscrow {
  id              String    @id @default(cuid())
  jobId           String
  quoteId         String
  customerId      String
  providerId      String
  amount          BigInt // quote price in cents
  serviceFee      BigInt // platform fee in cents
  totalAmount     BigInt // amount + fee in cents
  paymentMethod   String    @default("CARD") // CARD, CASH
  currency        String    @default("LKR")
  status          String    @default("PENDING") // PENDING, PROTECTED, ON_HOLD, RELEASED, REFUNDED
  heldAt          DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  cashConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([jobId])
  @@index([customerId])
  @@index([providerId])
  @@index([status])
}

model CommissionSettlement {
  id               String    @id @default(cuid())
  jobId            String
  escrowId         String
  providerId       String
  customerId       String
  jobAmount        BigInt // total job amount in cents (excl. fees)
  commissionRate   Float     @default(10.0) // Changed from 15 to 10
  commissionAmount BigInt // jobAmount * commissionRate / 10000 (bps calc)
  currency         String    @default("LKR")
  countryCode      String    @default("LK")
  status           String    @default("PENDING") // PENDING, SETTLED
  settledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([jobId])
  @@index([providerId])
  @@index([status])
  @@index([countryCode])
}

model ProviderWallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  isFrozen         Boolean  @default(false)
  currency         String   @default("LKR")
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model CustomerWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  isFrozen  Boolean  @default(false)
  currency  String   @default("LKR")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  walletType    String // PROVIDER, CUSTOMER
  type          String // CREDIT, DEBIT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String
  referenceType String // ESCROW_RELEASE, ESCROW_REFUND, WITHDRAWAL, SERVICE_FEE
  referenceId   String?
  currency      String   @default("LKR")
  status        String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([walletType])
  @@index([referenceType])
  @@index([createdAt])
}

model JobWorkspace {
  id                    String    @id @default(cuid())
  jobId                 String    @unique
  progressStatus        String    @default("ACCEPTED") // ACCEPTED, IN_PROGRESS, WAITING_CUSTOMER, COMPLETION_REQUESTED, COMPLETED, DISPUTED
  completionRequestedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([jobId])
}

model JobReview {
  id            String   @id @default(cuid())
  jobId         String
  customerId    String
  providerId    String
  quality       Int // 1-5
  communication Int // 1-5
  timeliness    Int // 1-5
  comment       String?
  createdAt     DateTime @default(now())

  @@unique([jobId, customerId])
  @@index([providerId])
}

model ProviderReview {
  id                String   @id @default(cuid())
  jobId             String
  providerId        String
  customerId        String
  cooperation       Int // 1-5
  communication     Int // 1-5
  overallExperience Int // 1-5
  comment           String?
  createdAt         DateTime @default(now())

  @@unique([jobId, providerId])
  @@index([customerId])
}

model IdentityDocument {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  docType     String // PASSPORT, NATIONAL_ID, DRIVERS_LICENSE
  side        String // FRONT or BACK
  imageUrl    String
  fullName    String? // "Full name exactly as on the ID" captured at submission
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  countryCode String    @default("LK")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// ADMIN PANEL MODELS
// ============================================

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  role                String    @default("ADMIN")
  firstName           String
  lastName            String
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  totpVerifiedAt      DateTime?
  assignedCountries   String    @default("")
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  parentId            String?
  createdBy           String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@index([parentId])
}

model AdminNotification {
  id          String   @id @default(cuid())
  adminUserId String
  type        String
  title       String
  message     String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([adminUserId, read])
  @@index([createdAt])
}

model AdminRefreshToken {
  id                String    @id @default(cuid())
  adminUserId       String
  tokenHash         String    @unique
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([tokenHash])
  @@index([adminUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminEmail  String
  adminRole   String
  action      String
  targetTable String?
  targetId    String?
  targetLabel String?
  oldValue    String?
  newValue    String?
  ipAddress   String
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetTable, targetId])
  @@index([action, createdAt])
}

/// Admin login attempt tracking with lockout
model AdminLoginAttempt {
  id            String   @id @default(cuid())
  adminUserId   String?
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([adminUserId, createdAt])
}

/// Admin session tracking (replaces AdminRefreshToken for JWT auth)
model AdminSession {
  id               String    @id @default(cuid())
  adminUserId      String
  refreshTokenHash String    @unique
  tokenFamilyId    String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([adminUserId])
  @@index([refreshTokenHash])
  @@index([tokenFamilyId])
}

/// Work queue — auto-created on KYC/dispute/settlement/flagged-job events
model AdminAlert {
  id           String    @id @default(cuid())
  type         String // fraud, dispute, payout, system, kyc, settlement, flagged_job
  severity     String // critical, high, medium, low
  title        String
  description  String?
  targetTable  String?
  targetId     String?
  assignedTo   String? // staff admin user ID (null = unassigned)
  assignedRole String? // which role should handle this: USER_MANAGEMENT, SUPPORT, FINANCE, MANAGER
  priority     String    @default("medium") // urgent, high, medium, low
  notes        String? // staff comments / resolution notes
  status       String    @default("open") // open, in_progress, resolved, dismissed
  slaMinutes   Int?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, severity])
  @@index([type, createdAt])
  @@index([assignedTo, status])
  @@index([assignedRole, status])
  @@index([status, priority, createdAt])
}

model PlatformSettings {
  id                        String   @id @default(cuid())
  platformFeeBps            Int      @default(1000) // 10% = 1000 basis points
  minJobAmountCents         BigInt   @default(500)
  maxJobAmountCents         BigInt   @default(1000000)
  escrowReleaseDays         Int      @default(3)
  maxActiveJobsPerUser      Int      @default(10)
  maxQuotesPerJob           Int      @default(10)
  maxDisputesPerJob         Int      @default(1)
  autoReleaseAfterDays      Int      @default(14)
  commissionRate            Float    @default(10.0) // Platform commission percentage
  weeklySettlementDay       String   @default("MONDAY") // Day commission is due
  suspensionGracePeriodDays Int      @default(7) // Days after due before suspension
  supportEmail              String?
  updatedBy                 String?
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())
}

// Phase 7 — Immutable price snapshot for every priced transaction
model PriceSnapshot {
  id                String   @id @default(cuid())
  jobId             String
  pricingVersion    String // e.g. "v1"
  currency          String   @default("LKR")
  baseAmount        BigInt // service base in minor units
  urgencyAmount     BigInt   @default(0) // urgency surcharge
  serviceModifiers  BigInt   @default(0) // other modifiers
  platformFeeBps    Int // commission basis points at time of quote
  platformFeeAmount BigInt // commission amount in minor units
  providerGross     BigInt // base + urgency + modifiers
  customerTotal     BigInt // providerGross + platformFeeAmount
  ruleIds           String   @default("[]") // JSON array of applied rule IDs
  createdAt         DateTime @default(now())

  @@index([jobId])
}

// Phase 7 — Configurable matching/pricing market settings (country-neutral)
model MarketConfig {
  id                   String   @id @default(cuid())
  countryCode          String   @unique // "GLOBAL" for defaults, "LK", "CA" etc.
  defaultCurrency      String   @default("LKR")
  matchingVersion      String   @default("v1")
  pricingVersion       String   @default("v1")
  // Matching weights (must sum to 100)
  weightCapability     Int      @default(30)
  weightReliability    Int      @default(20)
  weightReputation     Int      @default(20)
  weightAvailability   Int      @default(15)
  weightTravel         Int      @default(10)
  weightExperience     Int      @default(5)
  // Fair opportunity weights (Phase 10.2)
  weightFairness       Int      @default(10)
  weightPreferredSkill Int      @default(5)
  // Wave configuration (Phase 10.2)
  wave1Size            Int      @default(3)
  wave2Size            Int      @default(5)
  wave3Size            Int      @default(8)
  wave1ExpiryMinutes   Int      @default(15)
  wave2ExpiryMinutes   Int      @default(15)
  wave3ExpiryMinutes   Int      @default(30)
  // New provider configuration (Phase 10.2)
  newProviderBaseline  Float    @default(50)
  maxOpportunityBoost  Float    @default(15)
  // Pricing modifiers (basis points, 100 = 1%)
  urgentModifierBps    Int      @default(2500) // 25%
  emergencyModifierBps Int      @default(5000) // 50%
  urgencyCapBps        Int      @default(10000) // max 100% surge
  // Platform commission
  commissionRateBps    Int      @default(1000) // 10%
  minJobAmountCents    BigInt   @default(500)
  maxJobAmountCents    BigInt   @default(10000000)
  // Phase 10.3 — Benchmark configuration
  minBenchmarkSample       Int      @default(5)   // Minimum jobs for statistical benchmark
  benchmarkPercentileLow   Int      @default(25)  // P25 lower bound
  benchmarkPercentileHigh  Int      @default(75)  // P75 upper bound
  benchmarkOutlierIqrMult  Float    @default(1.5) // IQR multiplier for outlier detection
  benchmarkFallbackEnabled Boolean  @default(true) // Enable geographic fallback
  benchmarkResearchIntervalMonths Int @default(3) // Quarterly research cycle
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RealEstateListing {
  id          String  @id @default(cuid())
  postedBy    String
  title       String
  description String?

  // Property details
  type         String @default("sale") // legacy: sale, rent, commercial, land
  propertyType String @default("house") // house, apartment, commercial, land, rental
  purpose      String @default("sale") // sale, rent, commercial, land

  // Pricing
  priceLkr Float   @default(0)
  pricePer String? // null=sale, month/year=rent

  // Location (hierarchical, text-based)
  countryCode String  @default("LK")
  district    String?
  city        String?
  area        String?
  address     String?
  latitude    Float?
  longitude   Float?

  // Property specs
  bedrooms      Int?
  bathrooms     Int?
  parking       Int?
  areaSqft      Int?
  propertySize  Int? // sqft
  landSize      Int? // sqft for land
  yearBuilt     Int?
  isFurnished   Boolean @default(false)
  isNewProperty Boolean @default(true) // new or used

  // Media
  photos    String? // JSON array
  amenities String? // JSON array stored as string
  videoUrl  String?

  // Seller info
  contactPhone String?
  contactName  String?

  // Approval workflow
  status          String    @default("draft") // draft, pending, approved, rejected, published
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  // Boost/Featured
  isFeatured     Boolean   @default(false)
  boostTier      String? // null, basic, premium, top
  boostExpiresAt DateTime?
  boostedAt      DateTime?

