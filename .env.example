# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# JWT (required - app will crash without these)
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32"

# Marketplace/Staff auth secrets (required in production; must be independent of JWT_SECRET and of each other)
MARKETPLACE_JWT_SECRET="generate-with-openssl-rand-hex-32"
STAFF_JWT_SECRET="generate-with-openssl-rand-hex-32"

# Security (required - app will crash without these)
PASSWORD_PEPPER="generate-with-openssl-rand-hex-32"
CRON_SECRET="generate-with-openssl-rand-hex-32"
INTERNAL_SYNC_SECRET="generate-with-openssl-rand-hex-32"

# Testing (set to "true" only in local dev)
ALLOW_TEST_OTP="true"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (optional - needed for password reset emails)
SMTP_EMAIL="your-email@gmail.com"
SMTP_APP_PASSWORD="your-app-password"

# Admin Credentials (change these)
ADMIN_EMAIL="admin@example.invalid"
ADMIN_PASSWORD="generate-a-unique-admin-password"
BRANCH_ADMIN_EMAIL="branch-admin@example.invalid"
BRANCH_ADMIN_PASSWORD="generate-a-separate-branch-admin-password"
SEED_DEMO_PASSWORD="generate-a-dev-only-demo-password"
SEED_TASKER_PASSWORD="generate-a-dev-only-tasker-password"

# Company Info
COMPANY_NAME="Maintainex"
COMPANY_EMAIL="info@maintainex.com"
COMPANY_PHONE="+94 XX XXX XXXX"
COMPANY_ADDRESS="Jaffna, Sri Lanka"

# Google Analytics (GA4)
NEXT_PUBLIC_GA_ID="G-XXXXXXXX"

# Google Search Console
NEXT_PUBLIC_GSC_ID="your-verification-string"

# PayHere legacy integration (historical refunds/reconciliation only; never new checkout)
PAYHERE_MERCHANT_ID="your-payhere-merchant-id"
PAYHERE_MERCHANT_SECRET="your-payhere-merchant-secret"
PAYHERE_SANDBOX="true"  # Set to "false" in production

# PayHere Merchant API (refund/retrieval; create under PayHere Settings > API Keys)
PAYHERE_APP_ID="your-payhere-app-id"
PAYHERE_APP_SECRET="your-payhere-app-secret"

# PayPal REST API (server-only; NEVER prefix these with NEXT_PUBLIC_)
# Enable PayPal per market/currency in PaymentProviderConfig only after capability verification.
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
PAYPAL_SANDBOX="true"  # Set to "false" only for verified production credentials

# LIVE markets explicitly verified for PayPal Checkout on the MaintainEX merchant.
# Sandbox launch E2E is intentionally restricted in code to CA + CAD.
# Sri Lanka remains hard-blocked while official PayPal documentation says
# Checkout is not yet live there.
PAYPAL_MARKET_CHECKOUT_VERIFIED=""

# Public business contact details (intentionally exposed in the client bundle)
NEXT_PUBLIC_COMPANY_EMAIL="support@maintainex.lk"
NEXT_PUBLIC_COMPANY_PHONE=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
