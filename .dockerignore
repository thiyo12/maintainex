# Environment files - use Docker/Dokploy env vars instead
.env
.env.local
.env.production
.env.*.local

# Keep .env.example for reference
!.env.example

# Version control (huge, not needed in build context)
.git
.gitignore
Dockerfile.bak

# Node modules (rebuilt inside container)
node_modules
**/node_modules

# Build artifacts (rebuilt inside container)
.next
out
build
tsconfig.tsbuildinfo
next-env.d.ts

# Database dev artifacts (not needed for build)
*.db
*.db-journal

# Mobile app sources (web build doesn't need them, shrinks context massively)
apps/mobile/dist

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
*.pem

# IDE
.vscode/
.idea/

# Security-sensitive material must never enter Docker build context
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.npmrc
**/.netrc
**/.pypirc
**/secrets/
**/credentials/
credentials.json
credentials.*.json
*service-account*.json
*firebase-adminsdk*.json
id_rsa*
id_ed25519*
*.key
*.p8
*.p12
*.pfx
*.ppk
*.jks
*.keystore
*.mobileprovision

# Backups, exports and infrastructure state can contain credentials/data
backups/
backup/
maintainex-backup/
envs/
*.dump
*.backup
*.backup.sql
*.sql.gz
*.tar.gz
*.tgz
*.zip
.terraform/
*.tfstate
*.tfstate.*

